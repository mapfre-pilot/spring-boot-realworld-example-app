<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="1.0.0-1" author="SMK">
        <preConditions onFail="MARK_RAN"><not><tableExists tableName="smk_test"/></not></preConditions>
        <createTable tableName="smk_test">
            <column name="id" type="serial"><constraints nullable="false" primaryKey="true" primaryKeyName="pk_smk_test"/></column>
            <column name="codigo" type="varchar(255)"/>
            <column name="nombre" type="varchar(255)"/>
            <column name="categoria" type="varchar(255)"/>
            <column name="sistema" type="varchar(255)"/>
            <column name="descripcion" type="varchar(4000)"/>
            <column name="criticidad" type="varchar(255)"/>
            <column name="activo" type="boolean"/>
            <column name="motivo_inactivo" type="varchar(255)"/>
            <column name="origen_alta" type="varchar(255)"/>
            <column name="orden" type="integer"/>
            <column name="umbral_ms" type="integer"/>
        </createTable>
        <rollback><dropTable tableName="smk_test"/></rollback>
    </changeSet>
    <changeSet id="1.0.0-2" author="SMK">
        <preConditions onFail="MARK_RAN"><not><indexExists tableName="smk_test" indexName="uk_smk_test_codigo"/></not></preConditions>
        <addUniqueConstraint tableName="smk_test" columnNames="codigo" constraintName="uk_smk_test_codigo"/>
        <rollback><dropUniqueConstraint tableName="smk_test" constraintName="uk_smk_test_codigo"/></rollback>
    </changeSet>
</databaseChangeLog>
