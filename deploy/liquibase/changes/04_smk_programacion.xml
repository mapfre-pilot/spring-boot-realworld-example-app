<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="1.0.0-1" author="SMK">
        <preConditions onFail="MARK_RAN"><not><tableExists tableName="smk_programacion"/></not></preConditions>
        <createTable tableName="smk_programacion">
            <column name="id" type="serial"><constraints nullable="false" primaryKey="true" primaryKeyName="pk_smk_programacion"/></column>
            <column name="fecha_programada" type="timestamp"><constraints nullable="false"/></column>
            <column name="estado" type="varchar(20)"><constraints nullable="false"/></column>
            <column name="modo" type="varchar(30)"/>
            <column name="codigos" type="text"/>
            <column name="categorias" type="varchar(500)"/>
            <column name="sistemas" type="text"/>
            <column name="num_pruebas" type="integer"/>
            <column name="motivo" type="varchar(500)"/>
            <column name="origen" type="varchar(50)"/>
            <column name="creado_por" type="varchar(255)"/>
            <column name="fecha_creacion" type="timestamp"/>
            <column name="proceso_id" type="bigint"/>
            <column name="ejecucion_id" type="integer"/>
            <column name="fecha_lanzamiento" type="timestamp"/>
            <column name="cancelado_por" type="varchar(255)"/>
            <column name="fecha_cancelacion" type="timestamp"/>
        </createTable>
        <rollback><dropTable tableName="smk_programacion"/></rollback>
    </changeSet>
    <changeSet id="1.0.0-2" author="SMK">
        <preConditions onFail="MARK_RAN"><not><indexExists tableName="smk_programacion" indexName="ix_smk_programacion_estado_fecha"/></not></preConditions>
        <createIndex tableName="smk_programacion" indexName="ix_smk_programacion_estado_fecha">
            <column name="estado"/>
            <column name="fecha_programada"/>
        </createIndex>
        <rollback><dropIndex tableName="smk_programacion" indexName="ix_smk_programacion_estado_fecha"/></rollback>
    </changeSet>
</databaseChangeLog>
