{
  "name": "PGM — BFF + SPA a la vez (Podman, compose)",
  "dockerComposeFile": ["docker-compose.yml"],
  "service": "spa",
  "runServices": ["bff", "spa"],
  "workspaceFolder": "/workspaces/pgm",
  "remoteUser": "vscode",
  "shutdownAction": "stopCompose",
  "forwardPorts": [4200, 8080],
  "portsAttributes": {
    "4200": { "label": "PGM SPA (Angular)", "onAutoForward": "openBrowser" },
    "8080": { "label": "PGM BFF (Spring Boot)", "onAutoForward": "silent" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "angular.ng-template",
        "nrwl.angular-console",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "redhat.vscode-yaml"
      ],
      "settings": { "editor.formatOnSave": true, "editor.defaultFormatter": "esbenp.prettier-vscode" }
    }
  }
}
