      *CURSOR PARA RECUPERAR LISTADO COMPLETO DE EXPEDIENTES DE RESCATE         
      ******************************************************************        
           EXEC SQL DECLARE C1 CURSOR FOR                                       
           SELECT CCV0_ANIO            ,                                        
                  CCV0_KEXPEDIENTE     ,                                        
                  CCV0_NCOA            ,                                        
                  CCV0_CODCOA          ,                                        
                  CCV0_PORCOA          ,                                        
                  CCV0_IMPCOA          ,                                        
                  CCV0_IMPRTOINTEGRCOA ,                                        
                  CCV0_IMPREDPRICOA    ,                                        
                  CCV0_IMPREDTRANCOA   ,                                        
                  CCV0_IMPRTONETOCOA   ,                                        
                  CCV0_IMPRETCOA       ,                                        
                  CCV0_IMPCOMPENSATCOA                                          
                FROM TB372CCV0                                                  
                WHERE    CCV0_ANIO        = :CCV0-ANIO                          
                  AND    CCV0_KEXPEDIENTE = :CCV0-KEXPEDIENTE                   
                  AND    CCV0_NCOA        >= :CCV0-NCOA                         
             ORDER BY CCV0_ANIO,                                                
                      CCV0_KEXPEDIENTE,                                         
                      CCV0_NCOA                                                 
