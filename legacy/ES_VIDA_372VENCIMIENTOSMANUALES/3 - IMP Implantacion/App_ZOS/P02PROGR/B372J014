      **********************

      ***SACAMOS EL NOMBRE CON EL KPERSONA

           INITIALIZE WS-X620M050
536085     INITIALIZE WS-NOMBRECOMPLETO
536085     INITIALIZE WS-PERSONA
536085     INITIALIZE WS-KPERSONA
           MOVE 1 TO INDICE-P
           MOVE 1 TO INDICE-L

           MOVE X372M006-KPERSONA1-S(XN-J)  TO X620M050-KPERSONA-E
           MOVE 'C'                         TO X620M050-CLAVE

           CALL WS-B620N050 USING WS-X620M050.

           IF X620M050-CRETORNO-S    EQUAL '00'
                    AND X620M050-GNOMBRELARGO-S(1) NOT EQUAL SPACES


                MOVE X620M050-GNOMBRELARGO-S(1) TO WS-NOMBRE
                MOVE X620M050-GAPELLIDO1-S(1)   TO WS-APELLIDO1
                MOVE X620M050-GAPELLIDO2-S(1)   TO WS-APELLIDO2

                MOVE WS-NOMBRE(1:1)             TO DE-NOMBRE
                PERFORM UNTIL INDICE-P > 27
                        OR  WS-APELLIDO1(INDICE-P:2) EQUAL SPACES
                   IF WS-APELLIDO1(INDICE-P:2) NOT EQUAL SPACES
                      MOVE WS-APELLIDO1(INDICE-P:1)
                                 TO DE-APELLIDOS(INDICE-L:1)
                      ADD 1 TO INDICE-L
                   END-IF
                   ADD 1 TO INDICE-P
                END-PERFORM

                MOVE SPACES  TO DE-APELLIDOS(INDICE-L:1)
                ADD 1 TO INDICE-L

                IF INDICE-L < 27
                   MOVE 1 TO INDICE-P
                   PERFORM UNTIL INDICE-L > 27
                        OR  WS-APELLIDO2(INDICE-P:2) EQUAL SPACES
                      IF WS-APELLIDO2(INDICE-P:2) NOT EQUAL SPACES
                         MOVE WS-APELLIDO2(INDICE-P:1)
                                 TO DE-APELLIDOS(INDICE-L:1)
                         ADD 1 TO INDICE-L
                      END-IF
                      ADD 1 TO INDICE-P
                   END-PERFORM
                END-IF
                MOVE WS-PERSONA  TO DE-PERSONA

             ELSE

                MOVE SPACES      TO DE-PERSONA
                SET SI-ROLLBACK TO TRUE
      *         SET ERROR-GRAVE TO TRUE
                PERFORM 2321-ERR-CONSULTAR-PERSONA
