      **************************************************************            
      * VERIFICACION DE DATOS OBLIGATORIOS EN EL FICHERO DE TERCERO             
           IF WS-DAT3OS-CODPAIS-C EQUAL ZEROS                                   
              MOVE 11                    TO WS-DAT3OS-CODPAIS-C                 
           END-IF.                                                              

           IF WS-DAT3OS-CODPAIS-F EQUAL ZEROS                                   
              MOVE 11                    TO WS-DAT3OS-CODPAIS-F                 
           END-IF.                                                              

           IF WS-DAT3OS-TIP-VIA-C EQUAL SPACES                                  
              MOVE 'CL'                  TO WS-DAT3OS-TIP-VIA-C                 
           END-IF.                                                              

           IF WS-DAT3OS-NOM-VIA-C EQUAL SPACES                                  
              MOVE 'DESCONOCIDA'         TO WS-DAT3OS-NOM-VIA-C                 
           END-IF.                                                              


           IF WS-DAT3OS-LOCALID-C EQUAL SPACES                                  
              MOVE 'DESCONOCIDA'         TO WS-DAT3OS-LOCALID-C                 
           END-IF.                                                              

      * INFORMAMOS POR DEFECTO EL COD-PROV CORRESP                              
           IF WS-DAT3OS-CODPROV-C EQUAL ZEROS                                   
              IF WS-DAT3OS-CODPAIS-C = 11                                       
                 MOVE 28                    TO WS-DAT3OS-CODPROV-C              
              ELSE                                                              
                 MOVE 99                    TO WS-DAT3OS-CODPROV-C              
              END-IF                                                            
           END-IF                                                               
      *                                                               *         
      * INFORMAMOS POR DEFECTO EL COD-PROV FISCAL                               
           IF WS-DAT3OS-CODPROV-F EQUAL ZEROS                                   
              IF WS-DAT3OS-CODPAIS-F = 11                                       
                 MOVE 28                    TO WS-DAT3OS-CODPROV-F              
              ELSE                                                              
                 MOVE 99                    TO WS-DAT3OS-CODPROV-F              
              END-IF                                                            
           END-IF                                                               
      * INFORMAMOS POR DEFECTO EL COD-POSTAL FISCAL                             
           IF WS-DAT3OS-CODPOST-F EQUAL ZEROS                                   
              IF WS-DAT3OS-CODPAIS-F = 11                                       
                 MOVE 28000                 TO WS-DAT3OS-CODPOST-F              
              ELSE                                                              
                 MOVE 0 TO  WS-CODPOST                                          
                 COMPUTE WS-CODPOST = 99000 + WS-DAT3OS-CODPAIS-F               
                 MOVE WS-CODPOST           TO WS-DAT3OS-CODPOST-F               
                 MOVE 0 TO  WS-CODPOST                                          
              END-IF                                                            
           END-IF.                                                              
      * INFORMAMOS POR DEFECTO EL COD-POSTAL  CORRESP                           
           IF WS-DAT3OS-CODPOST-C EQUAL ZEROS                                   
              IF WS-DAT3OS-CODPAIS-C = 11                                       
                 MOVE 28000                 TO WS-DAT3OS-CODPOST-C              
              ELSE                                                              
                 MOVE 0 TO  WS-CODPOST                                          
                 COMPUTE WS-CODPOST = 99000 + WS-DAT3OS-CODPAIS-C               
                 MOVE WS-CODPOST           TO WS-DAT3OS-CODPOST-C               
                 MOVE 0 TO  WS-CODPOST                                          
              END-IF                                                            
           END-IF.                                                              
      * INFORMAMOS POR DEFECTO EL COD-POSTAL EXTRANJERO                         
           IF WS-DAT3OS-CODPST-EX  EQUAL SPACES                                 
           AND WS-DAT3OS-CODPAIS-C NOT EQUAL  11                                
                 MOVE 0 TO  WS-CODPOST                                          
                 COMPUTE WS-CODPOST = 99000 + WS-DAT3OS-CODPAIS-C               
                 MOVE WS-CODPOST-TXT       TO WS-DAT3OS-CODPOST-C               
                 MOVE 0 TO  WS-CODPOST                                          
           END-IF.                                                              

           IF WS-DAT3OS-TIP-VIA-F EQUAL SPACES                                  
              MOVE 'CL'                  TO WS-DAT3OS-TIP-VIA-F                 
           END-IF.                                                              

           IF WS-DAT3OS-NOM-VIA-F EQUAL SPACES                                  
              MOVE 'DESCONOCIDA'         TO WS-DAT3OS-NOM-VIA-F                 
           END-IF.                                                              


           IF WS-DAT3OS-LOCALID-F EQUAL SPACES                                  
              MOVE 'DESCONOCIDA'         TO WS-DAT3OS-LOCALID-F                 
           END-IF.                                                              

