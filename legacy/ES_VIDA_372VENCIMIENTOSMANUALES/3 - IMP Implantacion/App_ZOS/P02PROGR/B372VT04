      *D*                                                                       
      *     DISPLAY '3100-COMPACTAR-NOMBRE-COMPLETO.'                           
      *     DISPLAY 'NOMBRE ' RR041534-GNAPE1TOM(1)                             
      *F*                                                                       
           INITIALIZE WS-NOMBRE-COM                                             
           INITIALIZE WS-NOMBRE-COMPLETO                                        
           MOVE 1 TO INDICE-L                                                   
           MOVE 1 TO INDICE-P                                                   

           MOVE RR041534-GNAPE1TOM(1)               TO WS-APELLIDO1             
           PERFORM UNTIL INDICE-P > 25                                          
           IF WS-APELLIDO1(INDICE-P:2) NOT EQUAL SPACES                         
              MOVE WS-APELLIDO1(INDICE-P:1) TO WS-NOMBRE-COM(INDICE-L:1)        
              ADD 1 TO INDICE-L                                                 
           END-IF                                                               
           ADD 1 TO INDICE-P                                                    
           END-PERFORM                                                          

           IF INDICE-L NOT EQUAL 1                                              
              ADD 1 TO INDICE-L                                                 
           END-IF                                                               

           MOVE 1 TO INDICE-P                                                   
           MOVE RR041534-GNAPE2TOM(1)               TO WS-APELLIDO2             
           PERFORM UNTIL INDICE-P > 25                                          
           IF WS-APELLIDO2(INDICE-P:2) NOT EQUAL SPACES                         
              MOVE WS-APELLIDO2(INDICE-P:1) TO WS-NOMBRE-COM(INDICE-L:1)        
              ADD 1 TO INDICE-L                                                 
           END-IF                                                               
           ADD 1 TO INDICE-P                                                    
           END-PERFORM                                                          

           IF INDICE-L NOT EQUAL 1                                              
              MOVE ', '             TO WS-NOMBRE-COM(INDICE-L:2)                
              ADD 2 TO INDICE-L                                                 
           END-IF                                                               

           MOVE 1 TO INDICE-P                                                   
