       3000-EVALUACION-PORCE.                                                   
      **************************************************************            
      *D*                                                                       
DSPLYS*    DISPLAY 'B372JI13: 3000-EVALUACION-PORCE.'                           
      *T*                                                                       
      * DE CADA COASEGURADO SE OBTINE SU PORCENTAJE Y SE SUMA PARA              
      * QUE EL TOTAL = 100 , ACONTINUACION SE EVALUA EL RESULTADO               

           COMPUTE WS-TOTAL-PORCE = WS-VEN-PORCOA1 + WS-VEN-PORCOA2             
                                  + WS-VEN-PORCOA3 + WS-VEN-PORCOA4             
                                  + WS-VEN-PORCOA5 + WS-VEN-PORCOA6             
      *D*                                                                       
DSPLYS*    DISPLAY 'WS-VEN-PORCOA1:' WS-VEN-PORCOA1                             
DSPLYS*    DISPLAY 'WS-VEN-PORCOA2:' WS-VEN-PORCOA2                             
DSPLYS*    DISPLAY 'WS-VEN-PORCOA3:' WS-VEN-PORCOA3                             
DSPLYS*    DISPLAY 'WS-VEN-PORCOA4:' WS-VEN-PORCOA4                             
DSPLYS*    DISPLAY 'WS-VEN-PORCOA5:' WS-VEN-PORCOA5                             
DSPLYS*    DISPLAY 'WS-VEN-PORCOA6:' WS-VEN-PORCOA6                             
DSPLYS*    DISPLAY 'WS-TOTAL-PORCE:' WS-TOTAL-PORCE                             
      *T*                                                                       

           IF WS-TOTAL-PORCE NOT EQUAL 100                                      
           AND WS-TOTAL-PORCE > ZEROES                                          
      *D*                                                                       
DSPLYS*    DISPLAY 'ENTRO POR EL IF 1'                                          
      *T*                                                                       
              MOVE WS-VEN-ANIO        TO WS-SAL-ANIO                            
              MOVE WS-VEN-KEXPEDIENTE TO WS-SAL-KEXPEDIENTE                     
              MOVE WS-TOTAL-PORCE     TO WS-SAL-PORCE                           
              MOVE 'LA SUMA DE LOS PORCENTAJES SE EXCEDE DE 100'                
                                      TO WS-SAL-MENSAJE                         
              PERFORM 7000-ESCRIBIR-SALIDA                                      
OJO   *    ELSE                                                                 
      *D*                                                                       
DSPLYS*    DISPLAY 'ENTRO POR EL ELSE'                                          
      *T*                                                                       
OJO   *       PERFORM 3100-EVALUAR-DATOS-MCOA                                   
           END-IF                                                               
           .                                                                    

