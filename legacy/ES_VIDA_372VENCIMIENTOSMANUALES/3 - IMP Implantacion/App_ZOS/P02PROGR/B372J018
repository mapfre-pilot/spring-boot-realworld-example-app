           DISPLAY ' * * * * * * * * * * * * * * * * * * *'.
           DISPLAY ' *  LINEAS EN SAPASTON...: ' CT-SAPASTON.
           DISPLAY ' * * * * * * * * * * * * * * * * * * *'.
      *F*

           GOBACK.
      *
      *****************************************************************
      *                T R A T A M I E N T O S                        *
      *****************************************************************
      *
      *****************
        MOVER-DATOS-REG11 SECTION.
      *****************
      *
           INITIALIZE R-ASTOS-SAP.

           MOVE '11'           TO TIPO-REG-T1-SAP.
           MOVE '0003'         TO SOCIEDAD-T2-SAP.
           MOVE 450            TO NUM-ASTO-T1-SAP.
           MOVE 3              TO NUM-SERI-T1-SAP.
           MOVE 'EUR'          TO MONEDA-T1-SAP.
           MOVE SPACES         TO OF-CONT-RO-T1-SAP.
           MOVE 'XG'           TO INTERFAC-T1-SAP.
           MOVE RC37000-FPROCE TO F-CONTABIL-T1-SAP.

           WRITE R-ASTOS-SAP.
           ADD 1 TO CT-SAPASTON.
      *
      *
      *****************
       MOVER-DATOS-REG22 SECTION.
      *****************
      *
           INITIALIZE R-ASTOS-SAP.

           MOVE '22'           TO TIPO-REG-T2-SAP.
           MOVE '0003'         TO SOCIEDAD-T2-SAP.
           MOVE 450            TO NUM-ASTO-T2-SAP.
           MOVE 3              TO NUM-SERI-T2-SAP.
           MOVE 693502         TO CTA-CTBLE-T2-SAP.
           MOVE 'EUR'          TO MONEDA-T2-SAP.
           MOVE RC37000-FPROCE TO F-CONTABIL-T2-SAP.
           MOVE ZEROES         TO ORIG-GRUP-T2-SAP.
           MOVE ZEROES         TO F-VALOR-T2-SAP.
           MOVE ZEROES         TO NUM-EMPLE-T2-SAP.
           MOVE ZEROES         TO OF-CONT-RO-T2-SAP.
           MOVE ZEROES         TO CENTRO-COS-T2-SAP.

           IF R01-MOD-COMER = 00400
              PERFORM BUSCAR-MOD-ORIGEN
           ELSE
              MOVE SPACES                 TO MODALID-T2-SAP
              MOVE R01-MOD-COMER-ALF(2:3) TO MODALID-T2-SAP(2:3)
              MOVE R01-MOD-COMER-ALF(2:3) TO WS-SAP-MODALIDAD
              MOVE WS-SAP-KMODALIDAD      TO COB-GAR-T2-SAP
           END-IF
      *
           IF R01-KOFICINA NOT EQUAL SPACES
              PERFORM VALIDAR-OFICINA
           END-IF
      *
           MOVE 'RENTAS DB2'          TO CONCEPT-T2-SAP.
      *
           MOVE R01-IMPORTE-MASC TO  WS-IMPORTE-R
           MOVE R01-PCOASEGURO   TO WS-PCOASEGURO-R

           IF R01-CCOASEGURO = 'CE'
              COMPUTE IMP-DOC-T2-SAP = WS-IMPORTE-R * WS-PCOASEGURO-R
              MOVE IMP-DOC-T2-SAP     TO IMP-LOC-T2-SAP
           ELSE
              MOVE WS-IMPORTE-R       TO IMP-DOC-T2-SAP
              MOVE WS-IMPORTE-R       TO IMP-LOC-T2-SAP
           END-IF.

           MOVE 'D'                   TO DEB-HAB-T2-SAP.

           COMPUTE IMP-HABER = IMP-DOC-T2-SAP + IMP-HABER.
           COMPUTE IMP-DEBE = IMP-DOC-T2-SAP + IMP-DEBE.

           PERFORM GRABAR-SAL-COMPROB.

           WRITE R-ASTOS-SAP.
           ADD 1 TO CT-SAPASTON.
      *
      *
       GRABAR-REG22-TOTALES SECTION.
      *****************
      *
           INITIALIZE R-ASTOS-SAP.
      *
           MOVE '22'                  TO TIPO-REG-T2-SAP.
           MOVE '0003'                TO SOCIEDAD-T2-SAP.
           MOVE 450                   TO NUM-ASTO-T2-SAP.
           MOVE 3                     TO NUM-SERI-T2-SAP.
           MOVE 350010                TO CTA-CTBLE-T2-SAP.
           MOVE 'EUR'                 TO MONEDA-T2-SAP.
           MOVE RC37000-FPROCE        TO F-CONTABIL-T2-SAP.
           MOVE ZEROES                TO ORIG-GRUP-T2-SAP.
           MOVE ZEROES                TO F-VALOR-T2-SAP.
           MOVE ZEROES                TO NUM-EMPLE-T2-SAP.
           MOVE IMP-DEBE              TO IMP-DOC-T2-SAP
           MOVE IMP-HABER             TO IMP-LOC-T2-SAP
           MOVE 'H'                   TO DEB-HAB-T2-SAP
           MOVE 'RENTAS DB2'          TO CONCEPT-T2-SAP.

           WRITE R-ASTOS-SAP.
           ADD 1 TO CT-SAPASTON.

      *****************
       MOVER-DATOS-REG33 SECTION.
      *****************
      *
           INITIALIZE R-ASTOS-SAP.

           MOVE '33'           TO TIPO-REG-T3-SAP.
           MOVE '0003'         TO SOCIEDAD-T3-SAP.
           MOVE 450            TO NUM-ASTO-T3-SAP.
           MOVE 3              TO NUM-SERI-T3-SAP.
           MOVE 'EUR'          TO MONEDA-T3-SAP.
           MOVE SPACES         TO OF-CONT-RO-T3-SAP.
           MOVE RC37000-FPROCE TO F-CONTABIL-T3-SAP.
           MOVE IMP-DEBE       TO IMP-DEB-T3-SAP.
           MOVE IMP-HABER      TO IMP-HAB-T3-SAP.

           WRITE R-ASTOS-SAP.
           ADD 1 TO CT-SAPASTON.

      *****************
       BUSCAR-MOD-ORIGEN SECTION.
      *****************
      *
           INITIALIZE RA562086.

           MOVE 'M'                  TO RA562086-COPERACION.
           MOVE R01-KPOLIZA          TO RA562086-KPOLSUB.
           MOVE R01-KCERTIFICADO     TO RA562086-KCERTI.
           MOVE '101'                TO RA562086-KBENCON.

           CALL LT-VA562086 USING RA562086.

           IF RA562086-CRETORNO = ZEROS OR SPACES
              MOVE SPACES               TO MODALID-T2-SAP
              MOVE RA562086-KMOD-ORIGEN TO MODALID-T2-SAP(2:3)
              MOVE RA562086-KMOD-ORIGEN TO WS-SAP-MODALIDAD
              MOVE WS-SAP-KMODALIDAD  TO COB-GAR-T2-SAP
           END-IF.
      *
      *****************
       VALIDAR-OFICINA SECTION.
      *****************
      *
           INITIALIZE RR431011.
           MOVE R01-KOFICINA           TO RR431011-KOFICINA

           CALL LT-VR432011 USING RR431011

           IF RR431011-CRETORNO EQUAL TO '00'
               MOVE RR431011-KOFICINA    TO OF-CONT-RO-T2-SAP
               MOVE RR431011-KOFICINA    TO CENTRO-COS-T2-SAP
           ELSE
               MOVE ZEROES               TO OF-CONT-RO-T2-SAP
               MOVE ZEROES               TO CENTRO-COS-T2-SAP
           END-IF.
      *
      *****************
       GRABAR-SAL-COMPROB SECTION.
      *****************
      *
           INITIALIZE WS-R03 R03.

           MOVE WS-R01             TO R03-TB586BSS0-OFI.
           MOVE R-ASTOS-SAP        TO R03-SAPASTON.

           WRITE R03        FROM WS-R03.
