       PROCEDURE DIVISION.                                                      

      ***                                                                       
       PRINCIPAL.                                                               
      ***                                                                       
           PERFORM INICIO.                                                      
           PERFORM PROCESO-TECNICO UNTIL SW-FIN-TEC          =  'S'             
                                   OR    SW-FIN-EXP          =  'S'.            
           PERFORM P-PROCESO-AUXILIAR.                                          
           PERFORM PROCESO-AUXILIAR UNTIL SW-FIN-AUX          =  'S'            
                                    OR    SW-FIN-EXP          =  'S'.           
           PERFORM TERMINO.                                                     

      ***                                                                       
       INICIO.                                                                  
      ***                                                                       
           INITIALIZE WS-VARIABLES                                              
           MOVE FUNCTION CURRENT-DATE TO WS-FECHA-SIS.                          

           OPEN INPUT  FENTRAD1 FENTRAD2 FENTRAD3.                              
           OPEN OUTPUT FSALTEC FSALAUX.                                         

           PERFORM LEER-EXPEDIENTE.                                             
           PERFORM LEER-BDGI-TECNICO.                                           
           PERFORM LEER-BDGI-AUXILIAR.                                          

      *                                                                         
      ***                                                                       
       PROCESO-TECNICO.                                                         
      ***                                                                       

           IF WS-VEN-KSOLSUB EQUAL WS-KSOLSUB-TEC                               

              PERFORM GENERAR-FICHERO-TECNICO                                   
              PERFORM LEER-BDGI-TECNICO                                         
           ELSE                                                                 
              IF WS-VEN-KSOLSUB < WS-KSOLSUB-TEC                                
                 PERFORM LEER-EXPEDIENTE                                        
              ELSE                                                              
                 PERFORM LEER-BDGI-TECNICO                                      
              END-IF                                                            
           END-IF.                                                              

      ***                                                                       
       P-PROCESO-AUXILIAR.                                                      
      ***                                                                       
           CLOSE FENTRAD1.                                                      
           OPEN INPUT  FENTRAD1.                                                
           SET WS-NO-FIN-EXP TO TRUE.                                           
           PERFORM LEER-EXPEDIENTE.                                             
           PERFORM LEER-BDGI-AUXILIAR.                                          

      ***                                                                       
       PROCESO-AUXILIAR.                                                        
      ***                                                                       

           IF WS-VEN-KSOLSUB EQUAL WS-KSOLSUB-AUX                               

              PERFORM GENERAR-FICHERO-AUXLIAR                                   
              PERFORM LEER-BDGI-AUXILIAR                                        
           ELSE                                                                 
              IF WS-VEN-KSOLSUB < WS-KSOLSUB-AUX                                
                 PERFORM LEER-EXPEDIENTE                                        
              ELSE                                                              
                 PERFORM LEER-BDGI-AUXILIAR                                     
              END-IF                                                            
           END-IF.                                                              


      ***                                                                       
       LEER-EXPEDIENTE.                                                         
      ***                                                                       
           INITIALIZE WS-ENT-VENCIMIENTO.                                       

           READ FENTRAD1 INTO WS-ENT-VENCIMIENTO                                
                AT END SET WS-FIN-EXP TO TRUE.                                  

      ***                                                                       
       LEER-BDGI-TECNICO.                                                       
      ***                                                                       
           INITIALIZE WS-BDGI-TECNICO                                           

             READ FENTRAD2 INTO WS-BDGI-TECNICO                                 
                  AT END SET WS-FIN-TEC TO TRUE.                                

      ***                                                                       
       LEER-BDGI-AUXILIAR.                                                      
      ***                                                                       
           INITIALIZE WS-BDGI-AUXILIAR                                          

             READ FENTRAD3 INTO WS-BDGI-AUXILIAR                                
                  AT END SET WS-FIN-AUX TO TRUE.                                

      ***                                                                       
       GENERAR-FICHERO-TECNICO.                                                 
      ***                                                                       

      * SI EL ANIO NO CORRESPONDE AL ACTUAL MODIFICAMOS EL MES PARA QUE         
      * SEA EL ULTIMO DEL AÒO QUE SE GENERO.                                    

           IF X362X101-DATECO-AEJERCICIO < WS-ANO                               
              MOVE 12              TO  X362X101-DATECO-MEJERCICIO               
           END-IF                                                               

           COMPUTE X362X103-IRPF-IBRTPREST-IINDE =                              
                    X362X103-IRPF-IBRTPREST-IINDE * (-1)                        

           COMPUTE X362X103-IRPF-PRIMAS-PAGADAS =                               
                    X362X103-IRPF-PRIMAS-PAGADAS  * (-1)                        

           COMPUTE X362X103-IRPF-PRIM-IMPUTADAS =                               
                    X362X103-IRPF-PRIM-IMPUTADAS  * (-1)                        

           COMPUTE X362X103-IRPF-REND-INTEGRO   =                               
                    X362X103-IRPF-REND-INTEGRO    * (-1)                        

           COMPUTE X362X103-IRPF-IRREDUCCION-1  =                               
                    X362X103-IRPF-IRREDUCCION-1  * (-1)                         

           COMPUTE X362X103-IRPF-IRREDUCCION-2  =                               
                    X362X103-IRPF-IRREDUCCION-2  * (-1)                         

           COMPUTE X362X103-IRPF-IRREDUCCION-3  =                               
                    X362X103-IRPF-IRREDUCCION-3  * (-1)                         

           COMPUTE X362X103-IRPF-IRREDUCCION-4  =                               
                    X362X103-IRPF-IRREDUCCION-4  * (-1)                         

           COMPUTE X362X103-IRPF-IRREDUCCION-5  =                               
                    X362X103-IRPF-IRREDUCCION-5  * (-1)                         

           COMPUTE X362X103-IRPF-BASE-RETENCION =                               
                    X362X103-IRPF-BASE-RETENCION * (-1)                         

           COMPUTE X362X103-IRPF-IRETENCION     =                               
                    X362X103-IRPF-IRETENCION     * (-1)                         

           WRITE REG-SALTEC FROM WS-BDGI-TECNICO .                              

      ***                                                                       
       GENERAR-FICHERO-AUXLIAR.                                                 
      ***                                                                       

           COMPUTE X362X105-M190-REDUCCION       =                              
                    X362X105-M190-REDUCCION       * (-1)                        

           COMPUTE X362X105-M190-PENS-CONYU     =                               
                    X362X105-M190-PENS-CONYU      * (-1)                        

           COMPUTE X362X105-M190-ANU-ALIMENT    =                               
                    X362X105-M190-ANU-ALIMENT     * (-1)                        


           WRITE REG-SALAUX FROM WS-BDGI-AUXILIAR.                              

