      ******************************************************************        
      *2000-PROCESO.                                                            
      ******************************************************************        
       2000-PROCESO.                                                            
      *D*                                                                       
DSPLYS*    DISPLAY 'B372V012: 2000-PROCESO'                                     
      *F*                                                                       
      *                                                                         
           INITIALIZE RA761030                                                  
                      WS-PARAMETRO                                              
      *                                                                         
           MOVE X372VT12-KPOLIZA-E(4:7)     TO WS-POLIZA                        
           MOVE X372VT12-NSUBPOLIZA-E       TO WS-SUBPOL                        
           MOVE WS-KPOLIZA                  TO RA761030-KPOLSUB                 
           MOVE WS-FECHA-SIS                TO RA761030-FCUADROCOA              
           MOVE SPACES                      TO RA761030-CSG-AREAS               

      *                                                                         
      *D*                                                                       
DSPLYS*    DISPLAY 'WS-POLIZA: '            WS-POLIZA                           
DSPLYS*    DISPLAY 'WS-SUBPOL: '            WS-SUBPOL                           
DSPLYS*    DISPLAY 'RA761030-KPOLSUB: '     RA761030-KPOLSUB                    
DSPLYS*    DISPLAY 'RA761030-FCUADROCOA: '  RA761030-FCUADROCOA                 
DSPLYS*    DISPLAY 'RA761030-CSG-AREAS: '   RA761030-CSG-AREAS                  
      *                                                                         
      *F*                                                                       
           MOVE R000X000    OF DFHCOMMAREA                                      
                                  TO R000X000         OF WS-PARAMETRO           
           MOVE '00'              TO CAB-RESULTADO    OF WS-PARAMETRO           
           MOVE 'IDMS'            TO CAB-COD-LIBRERIA OF WS-PARAMETRO           
           MOVE 'VA761030'        TO CAB-COD-INTERFAZ OF WS-PARAMETRO           
           MOVE 'N'               TO CAB-ACTUALIZA    OF WS-PARAMETRO           
           MOVE LENGTH OF RA761030                                              
                                  TO CAB-LONG-DATOS   OF WS-PARAMETRO           
           MOVE RA761030          TO R000X001         OF WS-PARAMETRO           

           PERFORM ADAPTADOR-SALIDA                                             
      *D*                                                                       
DSPLYS*    DISPLAY 'SALGO ADAPTADOR-SALIDA-VALIDAR'                             
      *F*                                                                       
      *                                                                         
           MOVE R000X001    OF WS-PARAMETRO TO RA761030                         
      *D*                                                                       
DSPLYS*    DISPLAY 'RA761030-CSG-RETORNO: '   RA761030-CSG-RETORNO              
DSPLYS*    DISPLAY 'RA761030: '               RA761030                          
      *F*                                                                       
      *                                                                         
           IF RA761030-CSG-RETORNO NOT = '00' AND NOT = '21'                    
      *                                                                         
              SET  ERROR-GRAVE TO TRUE                                          
      *                                                                         
              INITIALIZE  X372VT12-SALIDA                                       
      *                                                                         
              MOVE '05'                                                         
                TO  X372VT12-CRETORNO-S                                         
              MOVE 'ERROR AL OBTENER CUADRO COASEGURADORA'                      
                TO  X372VT12-GERROR-S                                           
              MOVE 'VA761030'                                                   
                TO  X372VT12-GNOMPROG-S                                         
      *                                                                         
           ELSE                                                                 
      *                                                                         
              IF RA761030-CSG-RETORNO EQUAL '00'                                
      *                                                                         
                 PERFORM VARYING WS-TOT-IND FROM 1 BY 1                         
                           UNTIL WS-TOT-IND > 6                                 
      *                                                                         
                    COMPUTE WS-TOT-POR = WS-TOT-POR +                           
                                         RA761030-PCOASE(WS-TOT-IND)            
      *                                                                         
      *D*                                                                       
DSPLYS*     DISPLAY 'COA' WS-TOT-IND ': ' RA761030-KCOASE(WS-TOT-IND)           
DSPLYS*     DISPLAY 'POA' WS-TOT-IND ': ' RA761030-PCOASE(WS-TOT-IND)           
      *F*                                                                       
                 END-PERFORM                                                    
      *                                                                         
      *D*                                                                       
DSPLYS*          DISPLAY 'PORCENTAJE: '        WS-TOT-POR                       
      *F*                                                                       
      *                                                                         
                 IF WS-TOT-POR NOT = ZEROS                                      
                    IF WS-TOT-POR = 100                                         
      *                                                                         
                      PERFORM VARYING XN-M FROM 1 BY 1                          
                         UNTIL XN-M > 6                                         
                            OR RA761030-KCOASE (XN-M) EQUAL TO ZEROS            

                          MOVE RA761030-KSG-COASE-DGS (XN-M)                    
                            TO X372VT12-CODCOA-S (XN-M)                         
                          MOVE RA761030-PCOASE   (XN-M)                         
                            TO X372VT12-PORCOA-S (XN-M)                         
                          MOVE XN-M                                             
                            TO X372VT12-COASEGUROS-OCCURS-S                     

                       END-PERFORM                                              

                    ELSE                                                        
      *                                                                         
                       SET  ERROR-GRAVE TO  TRUE                                
                       MOVE '01'        TO  X372VT12-CRETORNO-S                 
                       MOVE 'ERROR EN LOS COASEGUROS'                           
                                        TO  X372VT12-GERROR-S                   
                       MOVE 'VA761030'  TO  X372VT12-GNOMPROG-S                 
      *                                                                         
                    END-IF                                                      
                 END-IF                                                         
              END-IF                                                            
              IF RA761030-CSG-RETORNO EQUAL '21'                                
      *                                                                         
                 INITIALIZE  X372VT12-SALIDA                                    
      *                                                                         
                    MOVE '10'           TO  X372VT12-CRETORNO-S                 
                    MOVE 'NO EXISTE COASEGURADORAS PARA LA POLIZA '             
                                        TO  X372VT12-GERROR-S                   
                    MOVE 'VA761030'     TO  X372VT12-GNOMPROG-S                 
      *                                                                         
              END-IF                                                            
           END-IF                                                               
           .                                                                    
