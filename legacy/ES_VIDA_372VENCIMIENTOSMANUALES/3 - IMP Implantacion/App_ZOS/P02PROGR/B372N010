                                         TO WS-DOMICILIO-COM(INDICE-L:1))       
                    ADD 1 TO INDICE-L                                           
                 END-IF                                                         
                 ADD 1 TO INDICE-P                                              
              END-PERFORM                                                       

              IF INDICE-L NOT EQUAL XN-I                                        
                 MOVE ','             TO WS-DOMICILIO-COM(INDICE-L:1)           
                 ADD 1 TO INDICE-L                                              
                 MOVE 'NUM '          TO WS-DOMICILIO-COM(INDICE-L:4)           
                 ADD 4 TO INDICE-L                                              
              END-IF                                                            

