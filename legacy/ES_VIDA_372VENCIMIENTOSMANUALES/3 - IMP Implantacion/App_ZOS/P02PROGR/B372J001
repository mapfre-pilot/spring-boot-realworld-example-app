                    MOVE DE-CENTIDAD-AUX TO WS-ANT-CENTIDAD
YACO                SET SW-NO-NEGATIVO TO TRUE
                    IF SW-SI-PRIMERA-VEZ
                       SET SW-NO-PRIMERA-VEZ TO TRUE
                       PERFORM 8100-CABECERA-BUZON
                    ELSE
                       PERFORM 2300-MOVER-TOTALES
                       PERFORM 2400-IMPRIMIR-TOTALES
                       PERFORM 8100-CABECERA-BUZON
                       INITIALIZE TOTALES LIN-DETALLE-TOTAL
                    END-IF
                 END-IF

                     IF DE-CAP-RTO-INT-AUX < 0
                        SET SW-SI-NEGATIVO TO TRUE
                     END-IF
YACO
YACO                 IF DE-CAP-RTO-INT-AUX > 0
YACO                    AND SW-SI-NEGATIVO
YACO                    PERFORM 2300-MOVER-TOTALES
YACO                    PERFORM 2400-IMPRIMIR-TOTALES
YACO                 ELSE
YACO                    PERFORM 2200-ESCRIBIR-LINEA
YACO                 END-IF

                 PERFORM 1050-LEER-REGISTRO
               END-PERFORM

               PERFORM 2300-MOVER-TOTALES
               PERFORM 2400-IMPRIMIR-TOTALES
               MOVE 0 TO CT-LINEA

           END-IF
              .
      ***************************************************************
       2200-ESCRIBIR-LINEA.
      ***************************************************************

      *
      **** IMPRESION DE LOS VALORES
      *

              MOVE LIN-DETALLE-AUX(3:56)  TO LIN-DETALLE
              MOVE DE-CAP-RTO-INT-AUX     TO DE-CAP-RTO-INT
              MOVE DE-CAP-RTO-NET-AUX     TO DE-CAP-RTO-NET
              MOVE DE-CAP-RTO-AUX         TO DE-CAP-RTO
              MOVE DE-COM1-RTO-INT-AUX    TO DE-COM1-RTO-INT
              MOVE DE-COM1-RTO-NET-AUX    TO DE-COM1-RTO-NET
              MOVE DE-COM1-RTO-AUX        TO DE-COM1-RTO
              MOVE DE-COM2-RTO-INT-AUX    TO DE-COM2-RTO-INT
              MOVE DE-COM2-RTO-NET-AUX    TO DE-COM2-RTO-NET
              MOVE DE-COM2-RTO-AUX        TO DE-COM2-RTO

              IF CT-LINEA EQUAL 0 OR CT-LINEA > 58
                 MOVE 0 TO CT-LINEA
                 PERFORM 2210-IMPRIMIR-INTRO
                 PERFORM 2220-IMPRIMIR-TITULOS-1
                 PERFORM 2240-IMPRIMIR-TITULOS-3
                 PERFORM 2230-IMPRIMIR-TITULOS-2
                 ADD 1 TO CT-PAGE
              END-IF

      * IMPRIMIR-LINEA-DETALLE.
              MOVE LIN-DETALLE TO RIMPRESO
              WRITE RIMPRESO AFTER ADVANCING 1 LINE
              ADD   1  TO  CT-LINEA
              PERFORM 2250-SUMA-TOTALES
               .

       2210-IMPRIMIR-INTRO.
      *********************
           MOVE CT-PAGE TO CB-INTRO-PAG.

           MOVE WS-ANO TO CB-INTRO-ANO
           MOVE WS-MES TO CB-INTRO-MES
           MOVE WS-DIA TO CB-INTRO-DIA

           MOVE CAB-INTRO   TO RIMPRESO.
           WRITE RIMPRESO AFTER ADVANCING 1 LINES.
           ADD 1 TO CT-LINEA.
           MOVE CAB-INTRO-1 TO RIMPRESO.
           WRITE RIMPRESO AFTER ADVANCING 1 LINES.
           ADD 1 TO CT-LINEA.
           MOVE CAB-INTRO-2 TO RIMPRESO.
           WRITE RIMPRESO AFTER ADVANCING 1 LINES.
           ADD 1 TO CT-LINEA.
           MOVE LINEA-BLANCO TO RIMPRESO.
           WRITE RIMPRESO AFTER ADVANCING 1 LINES.
           ADD 1 TO CT-LINEA.

       2220-IMPRIMIR-TITULOS-1.
      *****************
           MOVE DA TO CAB-DA
           MOVE DM TO CAB-DM
           MOVE DD TO CAB-DD

           MOVE HA TO CAB-HA
           MOVE HM TO CAB-HM
           MOVE HD TO CAB-HD

           MOVE CAB-TITULO-1 TO RIMPRESO.
           WRITE RIMPRESO AFTER ADVANCING 1 LINES.
           ADD 1 TO CT-LINEA.
           MOVE CAB-TITULO-1-SUBRAYADO TO RIMPRESO.
           WRITE RIMPRESO AFTER ADVANCING 1 LINES.
           ADD 1 TO CT-LINEA.
           MOVE CAB-TITULO-1-SUBTITULO TO RIMPRESO.
           WRITE RIMPRESO AFTER ADVANCING 1 LINES.
           ADD 1 TO CT-LINEA.
           MOVE LINEA-BLANCO TO RIMPRESO.
           WRITE RIMPRESO AFTER ADVANCING 1 LINES.
           ADD 1 TO CT-LINEA.

       2230-IMPRIMIR-TITULOS-2.
      *****************
           MOVE CAB-TITULO-2 TO RIMPRESO.
           WRITE RIMPRESO AFTER ADVANCING 1 LINES.
           ADD 1 TO CT-LINEA.
           MOVE CAB-TITULO-2-SUBRAYADO TO RIMPRESO.
           WRITE RIMPRESO AFTER ADVANCING 1 LINES.
           ADD 1 TO CT-LINEA.

       2240-IMPRIMIR-TITULOS-3.
      *****************
           MOVE CAB-TITULO-3 TO RIMPRESO.
           WRITE RIMPRESO AFTER ADVANCING 1 LINES.
           ADD 1 TO CT-LINEA.
           MOVE CAB-TITULO-3-SUBRAYADO TO RIMPRESO.
           WRITE RIMPRESO AFTER ADVANCING 1 LINES.
           ADD 1 TO CT-LINEA.

        2250-SUMA-TOTALES.
      **********************
      * SUMA PARA LOS TOTALES
           ADD   1  TO  DE-TOTAL-POLIZA
            ADD DE-CAP-RTO-INT-AUX             TO CAP-INT-TO
            ADD DE-CAP-RTO-NET-AUX             TO CAP-NET-TO
            ADD DE-CAP-RTO-AUX                 TO CAP-RET-TO
            ADD DE-COM1-RTO-INT-AUX             TO COM1-INT-TO
            ADD DE-COM1-RTO-NET-AUX             TO COM1-NET-TO
            ADD DE-COM1-RTO-AUX                 TO COM1-RET-TO
            ADD DE-COM2-RTO-INT-AUX             TO COM2-INT-TO
            ADD DE-COM2-RTO-NET-AUX             TO COM2-NET-TO
            ADD DE-COM2-RTO-AUX                 TO COM2-RET-TO
              .

       2300-MOVER-TOTALES.
      ********************
      * MOVEMOS LOS TOTALES A LAS MASCARAS
           MOVE CAP-INT-TO     TO DE-CAP-RTO-INT-TO
           MOVE CAP-NET-TO     TO DE-CAP-RTO-NET-TO
           MOVE CAP-RET-TO     TO DE-CAP-RTO-TO

           MOVE COM1-INT-TO    TO DE-COM1-RTO-INT-TO
           MOVE COM1-NET-TO    TO DE-COM1-RTO-NET-TO
           MOVE COM1-RET-TO    TO DE-COM1-RTO-TO

           MOVE COM2-INT-TO    TO DE-COM2-RTO-INT-TO
           MOVE COM2-NET-TO    TO DE-COM2-RTO-NET-TO
           MOVE COM2-RET-TO    TO DE-COM2-RTO-TO
              .

       2400-IMPRIMIR-TOTALES.
      *****************
           MOVE LIN-DETALLE-TOTAL-SUBRAYADO TO RIMPRESO.
           WRITE RIMPRESO AFTER ADVANCING 1 LINES.
           ADD 1 TO CT-LINEA.
           MOVE LIN-DETALLE-TOTAL TO RIMPRESO.
           WRITE RIMPRESO AFTER ADVANCING 1 LINES.
           ADD 1 TO CT-LINEA.

      * CALCULO PARA PASAR LA PAGINA
           SUBTRACT CT-LINEA FROM 59 GIVING AUX-LINEA
           INITIALIZE XN-K
           PERFORM VARYING XN-K FROM 1 BY 1
                    UNTIL XN-K > AUX-LINEA

                         MOVE LINEA-BLANCO TO RIMPRESO
                         WRITE RIMPRESO AFTER ADVANCING 1 LINES
                         ADD 1 TO CT-LINEA
           END-PERFORM
            .

      ******************************************************************
       8100-CABECERA-BUZON.
      ******************************************************************
           INITIALIZE CAB-0

           MOVE WS-ANT-CENTIDAD(1:2) TO CB-COMPANIA.
           MOVE NOMBRE-CADENA        TO CB-CADENA.
           MOVE 'FICHERO RENDIMIENTO POR CAPITAL'
             TO CB-FICHERO.

           MOVE WS-BUZON          TO CB-BUZON.

           WRITE RIMPRESO FROM CAB-0
MMC                              AFTER ADVANCING PAGE.
