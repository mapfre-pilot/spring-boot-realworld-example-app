              ADD X372N003-DURACION TO WS-ANO-AUX                               

              MOVE WS-FECHA-AUX     TO WS-FECHA-VTO                             

      * CAMPO PENDIENTE                                                         
              COMPUTE WS-PENDIENTE = (                                          
                      FUNCTION NUMVAL (X372N003-CAPITAL)     +                  
                      FUNCTION NUMVAL (X372N003-BENEFICIOS) -                   
                      FUNCTION NUMVAL (X372N003-ANTICIPO)   -                   
                      FUNCTION NUMVAL (X372N003-INTERESES-PEND)) / 100          


      * VALIDACION MODALIDAD                                                    
              COMPUTE WS-CAPITAL        =                                       
                      FUNCTION NUMVAL (X372N003-CAPITAL) / 100                  

              COMPUTE WS-BENEFICIOS     =                                       
                      FUNCTION NUMVAL (X372N003-BENEFICIOS) / 100               
              COMPUTE WS-ANTICIPO       =                                       
                      FUNCTION NUMVAL (X372N003-ANTICIPO)/ 100                  
              COMPUTE WS-INTERESES-PEND =                                       
                      FUNCTION NUMVAL (X372N003-INTERESES-PEND) / 100           

              EVALUATE X372N003-MODALIDAD                                       

                  WHEN 20                                                       
                  WHEN 32                                                       
                  WHEN 50                                                       
                  WHEN 118                                                      

                      COMPUTE WS-CAPITAL =                                      
                              (FUNCTION NUMVAL (X372N003-CAPITAL) / 2)          
                      COMPUTE WS-CAPITAL = WS-CAPITAL / 100                     
                      COMPUTE WS-BENEFICIOS =                                   
                               FUNCTION NUMVAL (X372N003-BENEFICIOS) / 2        
                      COMPUTE WS-BENEFICIOS = WS-BENEFICIOS / 100               
                      COMPUTE WS-ANTICIPO =                                     
                               FUNCTION NUMVAL (X372N003-ANTICIPO) / 2          
                      COMPUTE WS-ANTICIPO = WS-ANTICIPO / 100                   
                      COMPUTE WS-INTERESES-PEND =                               
                           FUNCTION NUMVAL (X372N003-INTERESES-PEND) / 2        
                     COMPUTE WS-INTERESES-PEND = WS-INTERESES-PEND / 100        

              END-EVALUATE                                                      

      * DATOS PERSONA                                                           
              PERFORM 2110-VALIDAR-PERSONA                                      

              IF X620M050-CRETORNO-S NOT = '00'                                 
      * SI NO EXISTE SE DA DE ALTA                                              
                 SET NO-EXISTE TO TRUE                                          

                 PERFORM 2120-ALTA-PERSONA                                      

                 IF X620M050-CRETORNO-S EQUAL '00'                              
                    MOVE X620M050-KPERSONA-S(1) TO WS-CODIGO-PERSONA            
                    MOVE '99'                   TO X372N003-CRETORNO-S          
                 ELSE                                                           
                    SET  ERROR-GRAVE TO TRUE                                    
                    MOVE '10'            TO X372N003-CRETORNO-S                 
                    MOVE 'ERROR AL DAR DE ALTA AL BENEFICIARIO '                
                      TO X372N003-GERROR-S                                      
                    MOVE 'B372N003'      TO X372N003-GNOMPROG-S                 
                 END-IF                                                         

              ELSE                                                              
      * SI EXISTE SE UTILIZAN SUS DATOS                                         
                 SET SI-EXISTE TO TRUE                                          

                 MOVE X620M050-KPERSONA-S(1) TO WS-CODIGO-PERSONA               

              END-IF                                                            

           CONTINUE.                                                            

