       2000-PROCESO.
      ****************

           MOVE 'N' TO SW-FIN-FICH-PEND.
           PERFORM 2010-LEER-PEND.

           PERFORM 2015-ESCRIBIR-SALIDA UNTIL SI-FIN-FICH-PEND.

      *---------------------*
       2015-ESCRIBIR-SALIDA.
      *---------------------*

           INITIALIZE RS-SALIDA
           MOVE 1              TO RS-TIPO-OPERACION
           MOVE RE-KPOLIZA     TO RS-KPOLIZA
           MOVE ZEROS          TO RS-KSUBPOLIZA
                                  RS-KCERTIFICADO
           MOVE RE-FULTVTO     TO RS-FEC-EFEC-PREST
           MOVE RE-KMODALIDAD  TO RS-MODALIDAD
           MOVE SPACES         TO RS-KGARANTIA
                                  RS-ACCION-COMERCIAL
           MOVE ZEROS          TO RS-IMPORTE-PB
           MOVE SPACES         TO RS-COD-EXPEDIENTE

           MOVE 1 TO IND
           PERFORM UNTIL RE-KPOLIZA NOT = RS-KPOLIZA
                      OR SI-FIN-FICH-PEND
                      OR IND > 3
              MOVE RE-FLIQUIDA      TO RS-FLIQUIDA       (IND)
              MOVE RE-EVALVTO       TO RS-EVALVTO        (IND)
              MOVE RE-ERECIBPTE     TO RS-ERECIBPTE      (IND)
              MOVE RE-EANTICPTE     TO RS-EANTICPTE      (IND)
              MOVE ZEROS            TO RS-EDESCREANT     (IND)
              MOVE RE-ERECIBANT     TO RS-EDESCRECINTER  (IND)
              MOVE RE-KPERSONA1     TO RS-KPERSONA-BENEF (IND)
                                       RS-KPERSONA-PERCEP(IND)
              MOVE RE-KBANCO77      TO RS-KBANCO77       (IND)
              MOVE RE-GDCCCC        TO RS-GDCCCC         (IND)
              MOVE RE-NCUENTACCC    TO RS-NCUENTACCC     (IND)
              IF RE-CTIPOLIQ = '1'
                 MOVE 'PO'          TO RS-TIPO-LIQ       (IND)
              END-IF
              IF RE-CTIPOLIQ = '2' OR '3'
                 MOVE 'CPB'         TO RS-TIPO-LIQ       (IND)
              END-IF
              MOVE SPACES           TO RS-IND-HEREDEROS  (IND)
              MOVE RE-ELIQUIDAC     TO RS-ELIQUIDAC      (IND)
              MOVE RE-FORDENPAG     TO RS-FORDENPAG      (IND)
              IF RE-CSITULIQ = 'PA'
                 MOVE RE-GUSERPAGO  TO RS-USUARIO         (IND)
                 MOVE 'PAG'         TO RS-ESTADO         (IND)
              ELSE
                 MOVE RE-GUSERCAPT  TO RS-USUARIO         (IND)
                 IF RE-CSITULIQ = 'PE'
                    MOVE 'PEN'      TO RS-ESTADO         (IND)
                 END-IF
                 IF RE-CSITULIQ = 'EM'
                    MOVE 'EMI'      TO RS-ESTADO         (IND)
                 END-IF
                 IF RE-CSITULIQ = 'TR'
                    MOVE 'TRA'      TO RS-ESTADO         (IND)
                 END-IF
              END-IF

              PERFORM 2010-LEER-PEND
              ADD 1 TO IND
           END-PERFORM

           IF IND > 3
            IF RE-KPOLIZA = RS-KPOLIZA
      *D*
              DISPLAY ' LA POLIZA: ' RE-KPOLIZA 'TIENE MAS DE 3'
                      ' LIQUIDADIONES'
                 UPON CONSOLE
      *F*
              PERFORM 3000-F-PROGRAMA
              PERFORM 10000-FIN
            END-IF
           END-IF
           ADD 1 TO CT-GRABADOS
           WRITE RLIQ-VERSUSONE FROM RS-SALIDA.

