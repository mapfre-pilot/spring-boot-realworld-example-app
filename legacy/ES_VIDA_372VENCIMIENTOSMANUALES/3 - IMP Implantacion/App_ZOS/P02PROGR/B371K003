ONEST  VER-SI-ONESAIT.
ONEST *****************************************************************
ONEST * PARA PODER APLICAR LAS CONDICIONES DE LA TABLA 003600
ONEST * TENEMOS QUE OBTENER
ONEST * LA REGIONAL Y LA DGT A PARTIR DE LA OFICINA DE PRODUCCION
ONEST *
ONEST *D*
ONEST      DISPLAY 'VER SI ONESAIT--------------'
ONEST      DISPLAY 'GNR0-KPOLIZA:' GNR0-KPOLIZA
ONEST      DISPLAY 'GNR0-KMODALIDAD:' GNR0-KMODALIDAD
ONEST      DISPLAY 'OFC0-KOFICINA  :' OFC0-KOFICINA
ONEST *F*
ONEST      PERFORM BUSCAR-REGIONAL-DGT
ONEST *D*
USGIBE     DISPLAY 'X4301091-KDIRGETE :' X4301091-KDIRGETE
USGIBE     DISPLAY 'X4301091-KDIRECREG:' X4301091-KDIRECREG
ONEST *F*
ONEST      PERFORM COMPROBAR-CONDICIONES
ONEST      .
ONEST
ONEST *------------------*
ONEST  COMPROBAR-CONDICIONES.
ONEST *------------------*
ONEST * LOS CAMPOS DE LA TABLA QUE VENGAN CON X, NO SE TIENEN EN
ONEST * CUENTA
ONEST *
ONEST * SI EN LA TABLA VIENE TODO EL VALOR A <X> INDICA QUE NO TENEMOS
ONEST * QUE PREGUNTAR POR ESE VALOR
ONEST *
ONEST *D*
ONEST       DISPLAY 'ENTRA EN COMPROBAR CONDICIONES'
ONEST *F*
ONEST       SET NO-ONESAIT TO TRUE
ONEST       PERFORM VARYING I FROM 1 BY 1 UNTIL I > CT-REGLAS
ONEST               OR SI-ONESAIT
ONEST *D*
ONEST        DISPLAY 'COMPARAMOS CON CLAVE :' TB-ONESAIT-CLAVE(I)
ONEST *F*
ONEST *
ONEST * CARTERA (COMO ES CARTERA DB2, HEMOS INICIALIZADO A '03')
ONEST *
ONEST        IF WS-CARTERA = TB-ONESAIT-CARTERA(I) OR
ONEST           TB-ONESAIT-CARTERA(I) = ALL 'X'
ONEST *D*
ONEST               DISPLAY 'CARTERA'
ONEST *F*
ONEST *
ONEST * DIRECCION GENERAL TERRITORIAL
ONEST *
USGIBE        IF X4301091-KDIRGETE = TB-ONESAIT-TERRITORIAL(I) OR
ONEST         TB-ONESAIT-TERRITORIAL(I) = ALL 'X'
ONEST *D*
ONEST               DISPLAY 'TERRITORIAL'
ONEST *F*
ONEST *
ONEST * DIRECCION REGIONAL
ONEST *
USGIBE         IF X4301091-KDIRECREG = TB-ONESAIT-REGIONAL(I) OR
ONEST             TB-ONESAIT-REGIONAL(I) = ALL 'X'
ONEST *D*
ONEST               DISPLAY 'TERRITORIAL'
ONEST *F*
ONEST *
ONEST * OFICINA DE PRODUCCION
ONEST * EN EL BATCH FILTRAMOS POR OFICINA DE PRODUCCION
ONEST *
ONEST           IF OFC0-KOFICINA    = TB-ONESAIT-OFI(I) OR
ONEST              TB-ONESAIT-OFI(I) = ALL 'X'
ONEST *D*
ONEST               DISPLAY 'OFICINA'
ONEST *F*
ONEST *
ONEST * MODALIDAD
ONEST *
ONEST            IF GNR0-KMODALIDAD   =
ONEST               TB-ONESAIT-MODALIDAD-NUM (I)       OR
ONEST               TB-ONESAIT-MODALIDAD(I) = ALL 'X'
ONEST *D*
ONEST               DISPLAY 'MODALIDAD'
ONEST *F*
ONEST *
ONEST * POLIZA
ONEST *
ONEST             IF GNR0-KPOLIZA =
ONEST                TB-ONESAIT-POLIZA(I) OR
ONEST                TB-ONESAIT-POLIZA(I) = ALL 'X'
ONEST *D*
ONEST               DISPLAY 'POLIZA'
ONEST *F*
ONEST *
ONEST * SUBPOLIZA
ONEST *
ONEST              MOVE GNR0-NSUBPOLIZA TO WS-SUBPOLIZA
ONEST              IF WS-SUBPOLIZA-ALF = TB-ONESAIT-SUBPOLIZA-NUM(I) OR
ONEST                 TB-ONESAIT-SUBPOLIZA(I) = ALL 'X'
ONEST *D*
ONEST               DISPLAY 'SUBPOLIZA'
ONEST *F*
ONEST *
ONEST * CERTIFICADO
ONEST *
ONEST               MOVE GNR0-NCERTIFICADO TO WS-CERTIFICADO
ONEST               IF WS-CERTIFICADO-ALF =
ONEST                  TB-ONESAIT-CERTIFICADO-NUM(I)
ONEST                  OR TB-ONESAIT-CERTIFICADO(I) = ALL 'X'
ONEST *D*
ONEST               DISPLAY 'CERTIFICADO'
ONEST *F*
ONEST2*
ONEST2* TIPO DE PRESTACION
ONEST2*
ONEST2              IF WS-TIPO-PRESTACION =
ONEST2                 TB-ONESAIT-TIPO-PRESTACION(I) OR
ONEST2                 TB-ONESAIT-TIPO-PRESTACION(I) = 'X'
ONEST *D*
ONEST               DISPLAY 'PRESTACION'
ONEST               DISPLAY 'ESTA POLIZA SE GESTIONA POR ONESAIT'
ONEST *F*
ONEST                  SET SI-ONESAIT TO TRUE
ONEST                  ADD 1 TO TB-ONESAIT-CONTADOR(I)
ONEST                  MOVE TB-ONESAIT-CLAVE(I) TO REGONE-CLAVE
ONEST2              END-IF
ONEST               END-IF
ONEST *
ONEST              END-IF
ONEST *
ONEST             END-IF
ONEST *
ONEST            END-IF
ONEST *
ONEST           END-IF
ONEST *
ONEST          END-IF
ONEST *
ONEST         END-IF
ONEST *
ONEST        END-IF
ONEST *
ONEST      END-PERFORM
ONEST *
ONEST      .
ONEST3*****************************************************************
ONEST3 BUSCAR-FORMATO.
ONEST3*****************************************************************
ONEST3* ACCEDEMOS A LA TABLA POR CADA UNA DE LAS CLAVES QUE TIENE
ONEST3*
ONEST3     MOVE X960M010-KCLAVE-S(X7) TO X960M010-KCLAVE-E
ONEST3*D*
ONEST3     DISPLAY 'B960M010 FMT'
ONEST3         ' CT- REGLAS:' CT-REGLAS '/'
               ' CLV:' X960M010-CLAVE-E '/'
               ' TAB:' X960M010-K1TAB-E '/'
               ' KCLAVE:' X960M010-KCLAVE-E   '/'
ONEST3         ' K1TAB ANT:'  X960M010-ANT-K1TAB
ONEST3         ' KCLAVE ANT:' X960M010-ANT-KCLAVE
               ' OCC ANT:' X960M010-ANT-KOCURRENCIA

ONEST *F*
ONEST3
ONEST3     CALL LT-B960M010 USING WS-X960M010
ONEST3
ONEST3*D*
ONEST3     DISPLAY 'B960M010 PARA FMT. RC:'
ONEST3              R960T001-KRETORNO OF WS-X960M010
ONEST3*F*
ONEST3     IF R960T001-KRETORNO OF WS-X960M010 EQUAL ZEROES
ONEST3
ONEST3        ADD  1 TO CT-REGLAS
ONEST3
ONEST3*D*
ONEST3        DISPLAY 'ALMACENAR FILTROS'
ONEST3*F*
ONEST3        PERFORM VARYING X9 FROM 1 BY 1
ONEST3             UNTIL X960M010-ATO0-KOCURRENCIA-S(X9) = 0
ONEST3             OR X9 > MAX-CAMPOS-3600
ONEST3       MOVE X9 TO WS-NVALOR
ONEST3       PERFORM ALMACENAR-FILTRO
ONEST3     END-PERFORM
ONEST3*
ONEST3* DISPLAYAMOS COMO SE CARGA LA TABLA DE CONDICIONES
ONEST3*D*
ONEST3     DISPLAY 'REGLA :'   CT-REGLAS '**********'
ONEST3     DISPLAY 'CLAVE:'    TB-ONESAIT-CLAVE (CT-REGLAS)
ONEST3     DISPLAY 'CONTADOR:' TB-ONESAIT-CONTADOR (CT-REGLAS)
ONEST3* DATOS DEL FORMATO (CONDICIONES)
ONEST3     DISPLAY 'CARTERA:'  TB-ONESAIT-CARTERA (CT-REGLAS)
ONEST3     DISPLAY 'TERRITORIAL:' TB-ONESAIT-TERRITORIAL (CT-REGLAS)
ONEST3     DISPLAY 'REGIONAL:'    TB-ONESAIT-REGIONAL (CT-REGLAS)
ONEST3     DISPLAY 'OFICINA:'     TB-ONESAIT-OFI (CT-REGLAS)
ONEST3     DISPLAY 'MODALIDAD:'   TB-ONESAIT-MODALIDAD(CT-REGLAS)
ONEST3     DISPLAY 'POLIZA:'      TB-ONESAIT-POLIZA (CT-REGLAS)
ONEST3     DISPLAY 'SUBPOLIZA:'   TB-ONESAIT-SUBPOLIZA(CT-REGLAS)
ONEST3     DISPLAY 'CERTIFICADO:' TB-ONESAIT-CERTIFICADO(CT-REGLAS)
ONEST3     DISPLAY 'TIPO PRESTAC.:'
ONEST3              TB-ONESAIT-TIPO-PRESTACION (CT-REGLAS)
      *F*
ONEST3                 ELSE
ONEST3                    MOVE 'ERROR. CONSULTAR CAMPOS TABLA 03600'
ONEST3                      TO  WS-MSG-CANCELA
ONEST3                    CALL  LT-CANCELA USING WS-MSG-CANCELA
ONEST3                 END-IF
ONEST3     .

