      *D*
      *    DISPLAY ' X372VT06-CRETORNO-S '  X372VT06-CRETORNO-S
      *    DISPLAY ' X372VT06-GERROR-S   '  X372VT06-GERROR-S
      *    DISPLAY ' X372VT06-GNOMPROG-S '  X372VT06-GNOMPROG-S
      *F*
           IF X372VT06-CRETORNO-S EQUAL TO '00'
   MSZ*       PERFORM 2300-EJECUTAR-CADENA
   MSZ        CONTINUE
           END-IF.

      ***************************************************************
       2300-EJECUTAR-CADENA.
      ***************************************************************

      * DETERMINAMOS EN EL ENTORNO QUE ESTAMOS
           MOVE R000X000 OF DFHCOMMAREA
             TO R000X000 OF WS-COMMAREA
           MOVE LT-0323770          TO WS-CADENA(2:7)
           EVALUATE NOMBRE-CICS(6:1)
               WHEN 'D'
                  MOVE CT-X           TO WS-CADENA(1:1)
               WHEN 'I'
                  MOVE CT-I           TO WS-CADENA(1:1)
               WHEN 'P'
                  MOVE CT-P           TO WS-CADENA(1:1)
               WHEN 'R'
                  MOVE CT-X           TO WS-CADENA(1:1)
           END-EVALUATE.

           EXEC CICS
                LINK PROGRAM(WS-BB00VIRD)
                COMMAREA(WS-COMMAREA)
                LENGTH(LENGTH OF WS-COMMAREA)
           END-EXEC.

