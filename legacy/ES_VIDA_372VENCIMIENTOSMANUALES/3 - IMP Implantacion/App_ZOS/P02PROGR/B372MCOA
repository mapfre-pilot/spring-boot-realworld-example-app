      *                                                                         
       2500-PROCESO-REGULA.                                                     
      *D*                                                                       
DSPLYS*    DISPLAY '2500-PROCESO-REGULA'                                        
      *F*                                                                       

            EXEC SQL                                                            
                SELECT                                                          
                      CCV0_ANIO             ,                                   
                      CCV0_KEXPEDIENTE      ,                                   
                      CCV0_NCOA             ,                                   
                      CCV0_CODCOA           ,                                   
                      CCV0_PORCOA           ,                                   
                      CCV0_IMPCOA           ,                                   
                      CCV0_IMPRTOINTEGRCOA  ,                                   
                      CCV0_IMPREDPRICOA     ,                                   
                      CCV0_IMPREDTRANCOA    ,                                   
                      CCV0_IMPRTONETOCOA    ,                                   
                      CCV0_IMPRETCOA        ,                                   
                      CCV0_IMPCOMPENSATCOA                                      
                INTO                                                            
                     :CCV0-ANIO            ,                                    
                     :CCV0-KEXPEDIENTE     ,                                    
                     :CCV0-NCOA            ,                                    
                     :CCV0-CODCOA          ,                                    
                     :CCV0-PORCOA          ,                                    
                     :CCV0-IMPCOA          ,                                    
                     :CCV0-IMPRTOINTEGRCOA ,                                    
                     :CCV0-IMPREDPRICOA    ,                                    
                     :CCV0-IMPREDTRANCOA   ,                                    
                     :CCV0-IMPRTONETOCOA   ,                                    
                     :CCV0-IMPRETCOA       ,                                    
                     :CCV0-IMPCOMPENSATCOA                                      
                FROM TB372CCV0                                                  
               WHERE   CCV0_ANIO             = :CCV0-ANIO                       
                 AND   CCV0_KEXPEDIENTE      = :CCV0-KEXPEDIENTE                
                 AND   CCV0_NCOA             = :CCV0-NCOA                       
            END-EXEC.                                                           
      *D*                                                                       
DSPLYS*    DISPLAY 'SQLCODE : ' SQLCODE                                         
      *F*                                                                       

           MOVE SQLCODE TO SW-ERROR-DB2                                         

           IF DB2-OK                                                            
              PERFORM 8100-INFORMAR-MODIFICA                                    
              PERFORM 2300-PROCESO-MODIF                                        
           ELSE                                                                 
              SET  ERROR-GRAVE TO TRUE                                          
              EVALUATE TRUE                                                     
                WHEN DB2-NOTFND                                                 
              PERFORM 8100-INFORMAR-MODIFICA                                    
              PERFORM 2100-PROCESO-ALTA                                         
                WHEN DB2-SELECTDUP                                              
                     MOVE LT-RETURN-ERR-CLVDUPLI                                
                       TO X372MCOA-RETORNO-S                                    
                     MOVE 'B372MCOA'                                            
                       TO X372MCOA-GNOMPROG-S                                   
                     MOVE 'EXITEN MAS DE UN EXPEDIENTE CON DATOS INFOR.'        
                       TO X372MCOA-ERROR-S                                      
                WHEN OTHER                                                      
                     MOVE LT-RETURN-ERR-OTHER                                   
                       TO X372MCOA-RETORNO-S                                    
                     MOVE 'ERROR AL OBTENER LOS EXPEDIENTES'                    
                       TO X372MCOA-ERROR-S                                      
                     MOVE 'B372MCOA'                                            
                       TO  X372MCOA-GNOMPROG-S                                  
              END-EVALUATE                                                      
           END-IF.                                                              

