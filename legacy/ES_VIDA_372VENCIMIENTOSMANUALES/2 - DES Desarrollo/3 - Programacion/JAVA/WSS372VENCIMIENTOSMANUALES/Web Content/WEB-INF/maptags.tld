		</attribute>
		<attribute>
			<name>collapsed</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Cuando se indique un tipo de caja colapsable, indica el estado inicial. El valor true indica que la caja se representará inicialmente colapsada. Valor por defecto: false.</description> -->
		</attribute>
		<attribute>
			<name>title</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Titulo de la caja de agrupación</description> -->
		</attribute>	
		<attribute>
			<name>titleKey</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Clave de la propiedad con el mensaje a mostrar como título en el ResourceBundle</description> -->
		</attribute>	
		<attribute>
			<name>bundle</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Nombre del ResourceBundle para las propiedades multiidioma</description> -->
		</attribute>
		<attribute>
			<name>locale</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Locale a usar para las propiedades multiidioma</description> -->
		</attribute>						
		<attribute>
			<name>width</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Ancho con el que se representará la caja de agrupación. El ancho se puede especificar de la misma manera que se especifica en HTML (ej. width="100px" o width="80%")</description> -->
		</attribute>						
		<attribute>
			<name>height</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Alto con el que se representará la caja de agrupación. El alto se puede especificar de la misma manera que se especifica en HTML (ej. height="100px" o height="80%")</description> -->
		</attribute>						
		<attribute>
			<name>top</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>posicionamiento absoluto en píxeles desde la parte superior de la página</description> -->
		</attribute>
		<attribute>
			<name>left</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>posicionamiento absoluto en píxeles desde el marge izquierdo de la página</description> -->
		</attribute>
		<attribute>
			<name>zindex</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Indica el índice de superposicion con respecto a otros elementos de la página</description> -->
		</attribute>
	</tag>
		
	<tag>
		<name>group-box-title</name>
		<tagclass>mapfre.wss000arquitect.jsp.etiquetas.GroupBoxTitleTag</tagclass>
		<bodycontent>JSP</bodycontent>
		<attribute>
			<name>width</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>ancho del area reservada para el titulo</description> -->
		</attribute>
	</tag> 

	<tag>
		<name>group-box-title-ext</name>
		<tagclass>mapfre.wss000arquitect.jsp.etiquetas.GroupBoxTitleExtTag</tagclass>
		<bodycontent>JSP</bodycontent>
		<attribute>
			<name>width</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>ancho del area reservada para la extension del titulo</description> -->
		</attribute>
	</tag> 
	
	<tag>
		<name>outputText</name>
		<tagclass>mapfre.wss000arquitect.jsp.etiquetas.OutputTextTag</tagclass>
		<bodycontent>JSP</bodycontent>
		<attribute>
			<name>top</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>posicionamiento absoluto en píxeles desde la parte superior de la página</description> -->
		</attribute>
		<attribute>
			<name>left</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>posicionamiento absoluto en píxeles desde el marge izquierdo de la página</description> -->
		</attribute>
		<attribute>
			<name>zindex</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Indica el índice de superposicion con respecto a otros elementos de la página</description> -->
		</attribute>
		<attribute>
			<name>fmt</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>expresión de formato a utilizar</description> -->
		</attribute>
		<attribute>
			<name>width</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Ancho con el que se representará el texto a mostrar. Ej width="30px" o width="10%"</description> -->
		</attribute>
		<attribute>
			<name>align</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Alineamiento horizontal. Valores posibles: center, left, right</description> -->
		</attribute>		
		<attribute>
			<name>bundle</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Indica el paquete de recursos usado por los atributos de internacionalización</description> -->
		</attribute>
		<attribute>
			<name>filter</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Si se establece el valor 'true', se filtran aquelloos caracterés sensibles al lenguaje HTML</description> -->
		</attribute>
		<attribute>
			<name>format</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Cadena con la representacion de formato con el que se escribirá el texto (según java.text.FormatMessage)</description> -->
		</attribute>
		<attribute>
			<name>formatKey</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Clave para localizar la cadena de formato a utilizar en caso de i18n</description> -->
		</attribute>
		<attribute>
			<name>ignore</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Si se establece el valor 'true' y el dato referenciado no se encuentra, no se escribe nada. En caso contrario se lanza excepción. </description> -->			
		</attribute>
		<attribute>
			<name>locale</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>locale que se usará para el formato de visualización</description> -->
		</attribute>
		<attribute>
			<name>name</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Nombre del bean, si no existe property se considerará dato simple</description> -->
		</attribute>
		<attribute>
			<name>property</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Propiedad del bean indicado en name. Si no se indica name se refiere a la propiedad del bean actionForm</description> -->
		</attribute>
		<attribute>
			<name>scope</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Ámbito donde se buscará el dato indicado. Valores posibles, 'page', 'request', 'session' o 'application'</description> -->
		</attribute>
		<attribute>
			<name>id</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Equivalente al atributo 'id' en HTML</description> -->
		</attribute>		
	</tag>
	
	<tag>
		<name>setStyle</name>
		<tagclass>mapfre.wss000arquitect.jsp.etiquetas.SetStyleTag</tagclass>
		<bodycontent>JSP</bodycontent>
		<attribute>
			<name>style</name>
			<required>true</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>'version0.1' indica estilo actual (defecto);'version1.0' indica estilo Majadahonda</description> -->
		</attribute>
	</tag>
	<tag>
		<name>tablecode</name>
		<tagclass>mapfre.wss000arquitect.jsp.etiquetas.TableCodeTag</tagclass>
		<bodycontent>JSP</bodycontent>
		<attribute>
			<name>tablename</name>
			<required>true</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Nombre de la tabla general</description> -->
		</attribute>
		<attribute>
			<name>lang</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Idioma (opcional). En caso de no indicarse, se tomara el idioma de usuario</description> -->
		</attribute>
		<attribute>
			<name>type</name>
			<required>true</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Tipo de descripción; 'l' para larga, 'c' para corta</description> -->
		</attribute>
		<attribute>
			<name>code</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Código de la tabla a mostrar</description> -->
		</attribute>
	</tag>
	
	<tag>
		<name>rowSelector</name>
		<tagclass>mapfre.wss000arquitect.jsp.etiquetas.rowselector.RowSelectorTag</tagclass>
		<bodycontent>JSP</bodycontent>
		<attribute>
			<name>tablename</name>
			<required>true</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Identificador unico de la tabla. No debe usarse el mismo identificador para distintas tablas</description> -->
		</attribute>
		<attribute>
			<name>name</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Nombre del bean, si no existe property se considerará dato simple</description> -->
		</attribute>
		<attribute>
			<name>property</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Propiedad del bean indicado en name. Si no se indica name se refiere a la propiedad del bean actionForm</description> -->
		</attribute>
		<attribute>
			<name>dataProvider</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>En caso de que los datos a mostrar NO provengan de una Lista en memoria, se indicará en este atributo el nombre completo de la clase DataProvider</description> -->
		</attribute>
		<attribute>
			<name>subsetName</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Nombre del bean, si no existe property se considerará dato simple</description> -->
		</attribute>
		<attribute>
			<name>subsetProperty</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Propiedad del bean indicado en name. Si no se indica name se refiere a la propiedad del bean actionForm</description> -->
		</attribute>
		<attribute>
			<name>subsetDataProvider</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>En caso de que los datos a mostrar NO provengan de una Lista en memoria, se indicará en este atributo el nombre completo de la clase DataProvider</description> -->
		</attribute>
		<attribute>
			<name>subsetOrderable</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>En caso de que los datos a mostrar NO provengan de una Lista en memoria, se indicará en este atributo el nombre completo de la clase DataProvider</description> -->
		</attribute>
		<!--
			<attribute>
			<name>pagesize</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			</attribute>
			<attribute>
			<name>pagesInBlock</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			</attribute>
		-->
		<attribute>
			<name>height</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Alto en pixeles. Si es tabla y ocupa más de este espacio, se añadira automaticamente una barra de scroll vertical a la derecha.</description> -->
		</attribute>
		<attribute>
			<name>top</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>posicionamiento absoluto en píxeles desde la parte superior de la página</description> -->
		</attribute>
		<attribute>
			<name>left</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>posicionamiento absoluto en píxeles desde el marge izquierdo de la página</description> -->
		</attribute>
		<attribute>
			<name>zindex</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Indica el índice de superposicion con respecto a otros elementos de la pagina</description> -->
		</attribute>
		<attribute>
			<name>var</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Nombre de la variable establecida en el contexto de página que representa cada elemento de la lista que se esta representando. Si no se indica este atributo, el nombre de esta variable es row.</description> -->
		</attribute>
		<attribute>
			<name>width</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Ancho de la tabla, puede indicarse mediante píxeles e.j. width="100" o mediante porcentaje e.j. width="15%" </description> -->
		</attribute>

	</tag>

	<tag>
		<name>rsColumn</name>
		<tagclass>mapfre.wss000arquitect.jsp.etiquetas.rowselector.RsColumnTag</tagclass>
		<bodycontent>JSP</bodycontent>
		<attribute>
			<name>width</name>
			<required>true</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Ancho de la columna, puede indicarse mediante píxeles e.j. width="100" o mediante porcentaje e.j. width="15%" </description> -->
		</attribute>
	</tag>

	<tag>
		<name>rsColumnHeader</name>
		<tagclass>mapfre.wss000arquitect.jsp.etiquetas.rowselector.RsColumnHeadTag</tagclass>
		<bodycontent>JSP</bodycontent>
		<attribute>
			<name>align</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Alineamiento horizontal</description> -->
		</attribute>
		<attribute>
			<name>valign</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Alineamiento vertical</description> -->
		</attribute>
		<attribute>
			<name>colspan</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Número de columnas por el que se expandirá la cabecera actual</description> -->
		</attribute>
		<attribute>
			<name>skip</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Indica si la esta celda actual de cabecera no se pintará (después de uso de colspan en alguna cabecera previa). Valor por defecto false.</description> -->
		</attribute>
	</tag>

	<tag>
		<name>rsColumnContent</name>
		<tagclass>mapfre.wss000arquitect.jsp.etiquetas.rowselector.RsColumnContentTag</tagclass>
		<bodycontent>JSP</bodycontent>
		<attribute>
			<name>align</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Alineamiento horizontal</description> -->
		</attribute>
		<attribute>
			<name>valign</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Alineamiento vertical</description> -->
		</attribute>
		<attribute>
			<name>cellpadding</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Espacio entre borde y contenido de la celda</description> -->
		</attribute>
	</tag>
	<tag>
		<name>rsRowId</name>
		<tagclass>mapfre.wss000arquitect.jsp.etiquetas.rowselector.RowIdTag</tagclass>
		<bodycontent>JSP</bodycontent>
	</tag>
	<tag>
		<name>rsTableCaption</name>
		<tagclass>mapfre.wss000arquitect.jsp.etiquetas.rowselector.rsTableCaptionTag</tagclass>
		<bodycontent>JSP</bodycontent>
	</tag>
	<tag>
		<name>rsSubsetTableCaption</name>
		<tagclass>mapfre.wss000arquitect.jsp.etiquetas.rowselector.rsSubsetTableCaptionTag</tagclass>
		<bodycontent>JSP</bodycontent>
	</tag>
</taglib>
