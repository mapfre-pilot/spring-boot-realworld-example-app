<?xml version="1.0" encoding="ISO-8859-1"?>

<!DOCTYPE taglib PUBLIC "-//Sun Microsystems, Inc.//DTD JSP Tag Library 1.1//EN" "http://java.sun.com/j2ee/dtds/web-jsptaglibrary_1_1.dtd">
<taglib>
	<tlibversion>1.0</tlibversion>
	<jspversion>1.1</jspversion>
	<shortname>mapfre</shortname>
	<uri></uri>
	<!--
	-->
	<tag>
		<name>body</name>
		<tagclass>mapfre.wss000arquitect.jsp.etiquetas.BodyTag</tagclass>
		<bodycontent>JSP</bodycontent>
		<attribute>
			<name>accessKey</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Posicionamiento foco por pulsación caracter</description> -->
		</attribute>
		<attribute>
			<name>background</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>bgColor</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Color de fondo</description> -->
		</attribute>
		<attribute>
			<name>bgProperties</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Propiedades de fondo</description> -->
		</attribute>
		<attribute>
			<name>bottonMargin</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Margen inferior</description> -->
		</attribute>
		<attribute>
			<name>styleClass</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Estilo aplicado a body (class)</description> -->
		</attribute>
		<attribute>
			<name>disabled</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Desactiva el elemento si es true</description> -->
		</attribute>
		<attribute>
			<name>hideFocus</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Oculta el foco</description> -->
		</attribute>
		<attribute>
			<name>leftMargin</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Margen izquierdo</description> -->
		</attribute>
		<attribute>
			<name>noWrap</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>rightMargin</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Margen derecho</description> -->
		</attribute>
		<attribute>
			<name>scroll</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Indica si se permite scroll</description> -->
		</attribute>
		<!--		<attribute>
			<name>style</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			</attribute>-->
		<attribute>
			<name>tabIndex</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Orden en tabulación</description> -->
		</attribute>
		<attribute>
			<name>text</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>title</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Equivalente a title de html</description> -->
		</attribute>
		<attribute>
			<name>topMargin</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Margen superior</description> -->
		</attribute>
		<attribute>
			<name>onLoad</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Código JS en la carga de la página</description> -->
		</attribute>
		<attribute>
			<name>onUnload</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Código JS al salir de la página</description> -->
		</attribute>
		<attribute>
			<name>onKeydown</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Código JS al pulsar una tecla</description> -->
		</attribute>		
		<attribute>
			<name>onKeyup</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Código JS al soltar una tecla</description> -->
		</attribute>		
		<attribute>
			<name>transition</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Indica si se debe mostrar el panel con el mensaje de espera</description> -->
		</attribute>
		<attribute>
			<name>style</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>'version0.1' indica estilo actual (defecto);'version1.0' indica estilo Majadahonda</description> -->
		</attribute>
	</tag>

	<tag>
		<name>label</name>
		<tagclass>mapfre.wss000arquitect.jsp.etiquetas.LabelTag</tagclass>
		<bodycontent>JSP</bodycontent>
		<attribute>
			<name>width</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Ancho con el que se representará la etiqueta. Ej width="30px" o width="10%"</description> -->
		</attribute>
		<attribute>
			<name>align</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Alineamiento horizontal. Valores posibles: center, left, right</description> -->
		</attribute>
		<attribute>
			<name>markAsReq</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Indica si la etiqueta incluirá la marca de obligatoriedad. Valores aceptados 'true' / 'false' (defecto)</description> -->
		</attribute>		
		<attribute>
			<name>emLevel</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Nivel de énfasis con el que se representará la etiqueta. Valores aceptados: 0 - normal. 1 - enfatizado</description> -->
		</attribute>		
		<attribute>
			<name>style</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>'version0.1' indica estilo actual (defecto);'version1.0' indica estilo Majadahonda</description> -->
		</attribute>
		<attribute>
			<name>id</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Equivalente al atributo 'id' en HTML</description> -->
		</attribute>
	</tag>

	<tag>
		<name>alertSupport</name>
		<tagclass>mapfre.wss000arquitect.jsp.etiquetas.AlertSupportTag</tagclass>
		<bodycontent>empty</bodycontent>
	</tag>

	<tag>
		<name>localSupport</name>
		<tagclass>mapfre.wss000arquitect.jsp.etiquetas.LocalSupportTag</tagclass>
		<bodycontent>empty</bodycontent>
	</tag>

	<tag>
		<name>postIt</name>
		<tagclass>mapfre.wss000arquitect.jsp.etiquetas.PostItTag</tagclass>
		<bodycontent>JSP</bodycontent>
		<attribute>
			<name>id</name>
			<required>true</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Equivalente al id del tag de html</description> -->
		</attribute>
		<attribute>
			<name>name</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Nombre del bean, si no existe property se considerará dato simple</description> -->
		</attribute>
		<attribute>
			<name>property</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Propiedad del bean indicado en name. Si no se indica name se refiere a la propiedad del bean actionForm</description> -->
		</attribute>
		<attribute>
			<name>top</name>
			<required>true</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>posicionamiento absoluto en píxeles desde la parte superior de la página</description> -->
		</attribute>
		<attribute>
			<name>left</name>
			<required>true</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>posicionamiento absoluto en píxeles desde el marge izquierdo de la página</description> -->
		</attribute>
		<attribute>
			<name>zindex</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Indica el índice de superposicion con respecto a otros elementos de la página</description> -->
		</attribute>
	</tag>

	<tag>
		<name>date</name>
		<tagclass>mapfre.wss000arquitect.jsp.etiquetas.InputDateTag</tagclass>
		<bodycontent>JSP</bodycontent>
		<attribute>
			<name>name</name>
			<required>true</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Nombre del dato en el formulario</description> -->
		</attribute>
		<attribute>
			<name>top</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>posicionamiento absoluto en píxeles desde la parte superior de la página</description> -->
		</attribute>
		<attribute>
			<name>left</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>posicionamiento absoluto en píxeles desde el marge izquierdo de la página</description> -->
		</attribute>
		<attribute>
			<name>zindex</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Indica el índice de superposicion con respecto a otros elementos de la página</description> -->
		</attribute>
		<attribute>
			<name>description</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Descripcion del campo</description> -->
		</attribute>
		<attribute>
			<name>calendar</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Indica si se muestra el icono para acceder al calendario. Acepta valores 'true' o 'false'. Si no se indica nada se considera 'false'</description> -->
		</attribute>
		<attribute>
			<name>separator</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Indica si se muestra el carácter separador entre los distintos campos de la fecha</description> -->
		</attribute>
		<attribute>
			<name>dayValue</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Valor por defecto para la caja de texto del día</description> -->
		</attribute>
		<attribute>
			<name>monthValue</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Valor por defecto para la caja de texto del mes</description> -->
		</attribute>
		<attribute>
			<name>yearValue</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Valor por defecto para la caja de texto del año</description> -->
		</attribute>
		<attribute>
			<name>srcName</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Nombre del bean para obtener valor inicial</description> -->
		</attribute>
		<attribute>
			<name>srcProperty</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Propiedad del bean para obtener valor inicial</description> -->
		</attribute>
		<attribute>
			<name>format</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>formato de visualización del control</description> -->
		</attribute>
		<attribute>
			<name>targetFormat</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>formato en el que se enviará el dato en el formulario</description> -->
		</attribute>
		<attribute>
			<name>srcFormat</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>formato que se utilizará para interpretar la fecha indicada con srcName/srcProperty en caso de que esta sea de tipo String </description> -->
		</attribute>
		<attribute>
			<name>yearDigits</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>indica el número de chars disponibles para el año. Sólo se aceptan los valores: 2 y 4</description> -->
		</attribute>
		<attribute>
			<name>locale</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>locale que se usará para el formato de visualización</description> -->
		</attribute>
		<attribute>
			<name>disabled</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Desactiva el elemento si es true</description> -->
		</attribute>
		<attribute>
			<name>readonly</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>De solo lectura si es true</description> -->
		</attribute>
		<attribute>
			<name>onfocus</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Evento cuando coge el foco</description> -->
		</attribute>
		<attribute>
			<name>onblur</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Evento cuando pierde el foco</description> -->
		</attribute>
		<attribute>
			<name>tabindex</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Orden de tabulación del elemento dentro de la página</description> -->
		</attribute>
	</tag>

	<tag>
		<name>ccc</name>
		<tagclass>mapfre.wss000arquitect.jsp.etiquetas.CccTag</tagclass>
		<bodycontent>JSP</bodycontent>
		<attribute>
			<name>nameBanco</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>clave del Banco en la cuenta ccc</description> -->
		</attribute>
		<attribute>
			<name>nameSucursal</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>clave de la Sucursal en la cuenta ccc</description> -->
		</attribute>
		<attribute>
			<name>nameControl</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>dígito de control en la cuenta ccc</description> -->
		</attribute>
		<attribute>
			<name>nameCuenta</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>clave de la cuenta bancaria en la cuenta ccc</description> -->
		</attribute>
		<attribute>
			<name>top</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>posicionamiento absoluto en píxeles desde la parte superior de la página</description> -->
		</attribute>
		<attribute>
			<name>left</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>posicionamiento absoluto en píxeles desde el marge izquierdo de la página</description> -->
		</attribute>
		<attribute>
			<name>zindex</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Indica el índice de superposicion con respecto a otros elementos de la página</description> -->
		</attribute>
		<attribute>
			<name>disable</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Desactiva el elemento si es true</description> -->
		</attribute>
		<attribute>
			<name>readonly</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>De solo lectura si es true</description> -->
		</attribute>
		<attribute>
			<name>tabindex</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Orden en tabulación</description> -->
		</attribute>
		<attribute>
			<name>onblur</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Evento cuando pierde el foco</description> -->
		</attribute>
		<attribute>
			<name>onfocus</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Evento cuando coge el foco</description> -->
		</attribute>
		<attribute>
			<name>onchange</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Evento cuando cambia de valor</description> -->
		</attribute>
		<attribute>
			<name>onclick</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Evento cuando se hace un simple clic</description> -->
		</attribute>
		<attribute>
			<name>ondblclick</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Evento cuando se hace un doble clic</description> -->
		</attribute>
		<attribute>
			<name>name</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Nombre del bean, si no existe property se considerará dato simple</description> -->
		</attribute>
		<attribute>
			<name>propertyBanco</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>propiedad del bean Banco en ccc</description> -->
		</attribute>
		<attribute>
			<name>propertySucursal</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>propiedad del bean Sucursal en ccc</description> -->
		</attribute>
		<attribute>
			<name>propertyControl</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>propiedad del bean del dígito de Control en ccc</description> -->
		</attribute>
		<attribute>
			<name>propertyCuenta</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>propiedad del bean Cuenta en ccc</description> -->
		</attribute>
		<attribute>
			<name>valueBanco</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>valor por defecto para Banco en ccc</description> -->
		</attribute>
		<attribute>
			<name>valueSucursal</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>valor por defecto para Sucursal en ccc</description> -->
		</attribute>
		<attribute>
			<name>valueControl</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>valor por defecto para dígito Control en ccc</description> -->
		</attribute>
		<attribute>
			<name>valueCuenta</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>valor por defecto para Cuenta en ccc</description> -->
		</attribute>
		<attribute>
			<name>accesskey</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Posicionamiento foco por pulsacion caracter</description> -->
		</attribute>
		<attribute>
			<name>title</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Equivalente a title de html</description> -->
		</attribute>
		<attribute>
			<name>style</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>'version0.1' indica estilo actual (defecto);'version1.0' indica estilo Majadahonda</description> -->
		</attribute>
	</tag>

	<tag>
		<name>text</name>
		<tagclass>mapfre.wss000arquitect.jsp.etiquetas.TextTag</tagclass>
		<bodycontent>JSP</bodycontent>
		<attribute>
			<name>accesskey</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Posicionamiento foco por pulsación caracter</description> -->
		</attribute>
		<attribute>
			<name>alt</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Equivalente a alt de html</description> -->
		</attribute>
		<attribute>
			<name>altKey</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Equivalente a altKey de html</description> -->
		</attribute>
		<attribute>
			<name>disabled</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Desactiva el elemento si es true</description> -->
		</attribute>
		<attribute>
			<name>indexed</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Indica si el dato asociado se obtiene a partir del índice de iteración indicado por la etiqueta <logic:iterate></description> -->			
		</attribute>
		<attribute>
			<name>maxlength</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Cadena con un máximo de caracteres</description> -->
		</attribute>
		<attribute>
			<name>name</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Nombre del bean, si no existe property se considerará dato simple</description> -->
		</attribute>
		<attribute>
			<name>onblur</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Evento cuando pierde el foco</description> -->
		</attribute>
		<attribute>
			<name>onchange</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Evento cuando cambia de valor</description> -->
		</attribute>
		<attribute>
			<name>onclick</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Evento cuando se hace un simple clic</description> -->
		</attribute>
		<attribute>
			<name>ondblclick</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Evento cuando se hace un doble clic</description> -->
		</attribute>
		<attribute>
			<name>onfocus</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Evento cuando coge el foco</description> -->
		</attribute>
		<attribute>
			<name>onkeydown</name>
