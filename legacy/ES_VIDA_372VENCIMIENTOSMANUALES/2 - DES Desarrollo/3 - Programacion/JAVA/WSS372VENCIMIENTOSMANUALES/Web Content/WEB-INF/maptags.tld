		<attribute>
			<name>name</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Identificador del elemento dentro de la página</description> -->
		</attribute>		
		<attribute>
			<name>layout</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Tipo de caja a representar. Valores admitidos: line, dashed, solid o collapsible.</description> -->
		</attribute>		
		<attribute>
			<name>colorLevel</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!--description>Color con el que se representará la caja de agrupación. Valores admitidos: 1 (defecto) y 2.</description> -->
		</attribute>
		<attribute>
			<name>indentLevel</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
