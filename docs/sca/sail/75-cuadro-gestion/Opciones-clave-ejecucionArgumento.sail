/* R56 Cuadro de Gestión: datos del argumento que CMD CompletarAccion graba en SCA2 Ejecucion Argumento; el resto del flujo no los usa */ejecucionArgumento: a!map(codTipoArgumento: index(local!argumentoSeleccionado, "codTipoArgumento", null), descTipoArgumento: index(local!argumentoSeleccionado, "descTipoArgumento", null), codIdCampana: index(local!argumentoSeleccionado, "codIdCampana", null), argumentoEconomico: index(local!argumentoSeleccionado, "mcaEconomico", null), numBonAplic: if(a!isNullOrEmpty(local!numBonAplic), index(local!argumentoSeleccionado, "numTipBon", null), local!numBonAplic), lineaNegocio: index(local!dataRecuperacion, "lineaNegocio", null), codPerfil: local!codPerfil),
