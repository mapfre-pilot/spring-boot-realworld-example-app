{
  "name": "PGM SPA (Angular 19 + Nx) — Podman",
  "build": {
    "dockerfile": "Dockerfile",
    "args": { "BASE_IMAGE": "${localEnv:NODE_IMAGE:node:22-bookworm-slim}" }
  },
  "runArgs": ["--userns=keep-id", "--security-opt", "label=disable"],
  "containerUser": "vscode",
  "remoteUser": "vscode",
  "updateRemoteUserUID": false,
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/pgm-spa,type=bind,Z",
  "workspaceFolder": "/workspaces/pgm-spa",
  "mounts": ["source=pgm-npm,target=/home/vscode/.npm,type=volume"],
  "containerEnv": {
    "PGM_BFF_URL": "${localEnv:PGM_BFF_URL:http://host.containers.internal:8080}",
    "NPM_CONFIG_REGISTRY": "${localEnv:NPM_CONFIG_REGISTRY:}"
  },
  "forwardPorts": [4200],
  "portsAttributes": { "4200": { "label": "PGM SPA", "onAutoForward": "openBrowser" } },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": ["angular.ng-template", "nrwl.angular-console", "dbaeumer.vscode-eslint", "esbenp.prettier-vscode"],
      "settings": { "editor.formatOnSave": true, "editor.defaultFormatter": "esbenp.prettier-vscode" }
    }
  }
}
