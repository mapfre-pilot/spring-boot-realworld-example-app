# Base environment
ENVIRONMENT=local
APPLICATION_NAME=tva
SERVICE_NAME=esp-appianesad-tva

# Launcher environment
DJANGO_PROJECT=config

# SECURITY
SECRET_KEY="INSECURE"
DEBUG=True
ALLOWED_HOSTS=*

# LOGGING
LOGGER_LEVEL=INFO

# Database (sin DB_HOST → sqlite local)
#DB_HOST=localhost
#DB_NAME=tva
#DB_USER=tva
#DB_PASSWORD=CHANGEME
#DB_PORT=5432

# Cache / Redis
CACHE_DEFAULT_TIMEOUT=300
CACHE_OAUTH_TTL=3600
#REDIS_HOST=localhost
#REDIS_PORT=6379
#REDIS_DB=0

# Celery
#CELERY_BROKER_URL=redis://localhost:6379/1
#CELERY_RESULT_BACKEND=redis://localhost:6379/1
#CELERY_TASK_ALWAYS_EAGER=True

# JWT local (solo ENVIRONMENT=local) — crear con manage.py crear_token_local

# JWT OIDC (resto de entornos)
#OAUTH_JWKS_URI=https://CHANGEME/.well-known/jwks.json
#OAUTH_AUDIENCE=CHANGEME
#OAUTH_ISSUER=CHANGEME
#OAUTH_JWKS_CACHE_TTL=3600

# TVA — conectores externos
#
# API Life — connected system "TVA API Life" (Basic preemptive, usuario real APPSAVI).
# Sirve los 17 endpoints TVA_API_Life_* + TVA_API_SBC_maximo + TVA_GestionarPersonas.
APILIFE_MODE=mock
#APILIFE_BASE_URL=https://<host-api-life>:<puerto>/
#APILIFE_USERNAME=APPSAVI
#APILIFE_PASSWORD=
APILIFE_TIMEOUT=30
# Connected system "TVA API Life APPINVE" (usuario APPINVE; fallback a las de arriba)
#APILIFE_APPINVE_USERNAME=APPINVE
#APILIFE_APPINVE_PASSWORD=
# cons!CMP_VAL_TRADUCCION_ES / cons!TVA_ACRONIMO_APLICACION (cross-app, defaults "es"/"TVA")
#APILIFE_ACCEPT_LANGUAGE=es
#APILIFE_APPLICATION_ID=TVA

# MISV perfilado de clientes — connected system "TVA MISV" (Basic, usuario APPCMPA).
# GET {MISV_BASE_URL}/NOVAServices/rest/RSPerfiladoClienteV2/obtenerPerfiladoCliente
#MISV_MODE=mock
#MISV_BASE_URL=https://<host-misv>:<puerto>
#MISV_USERNAME=APPCMPA
#MISV_PASSWORD=
MISV_TIMEOUT=20
# cons!VIDA_ACRONIMO_APLICACION / cons!VIDA_CODIGOS_TIPO_PERSONA_FISICA (cross-app)
#MISV_APLICACION=VIDA
#MISV_TIPO_PERSONA=F

# RIC (MU_ObtenerClienteRIC — regla cross-app fuera del dump; contrato por confirmar
# con los dueños de MU). GET {RIC_BASE_URL}/{RIC_PATH}?documento=<nif>
#RIC_MODE=mock
#RIC_BASE_URL=https://<host-ric>:<puerto>
#RIC_PATH=personas
#RIC_USERNAME=
#RIC_PASSWORD=
RIC_TIMEOUT=30

# Perfil de usuario — integración SOAP TVA_WSDL_IGestionarPerfilUsuario hacia SOA7
# (WSSE UsernameToken; usuario real APPRIMO). POST a
# {SOA_BASE_URL}/MAVISA_910Usuario_SOAMEDWeb/sca/MAVISA_910Usuario_WSDL
#PERFIL_USUARIO_MODE=mock
#SOA_BASE_URL=https://<host-soa7>:<puerto>/
#SOA_USERNAME=APPRIMO
#SOA_PASSWORD=
SOA_TIMEOUT=10

# Alertas
#ALERTAS_EMAIL_TO=CHANGEME@CHANGEME
#ALERTAS_EMAIL_FROM=noReply@tva.local
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Pop-ups Appian Embedded (RGPD/DNI/test conveniencia). real requiere la API key (no versionada).
APPIAN_EMBED_MODE=mock
APPIAN_EMBED_BASE_URL=https://mapfrespain-test.appiancloud.com/suite
APPIAN_EMBED_API_KEY=CHANGEME
APPIAN_EMBED_TIMEOUT=30
APPIAN_EMBED_EMAIL_AVISOS=
